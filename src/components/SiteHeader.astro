---
import { ArrowDownRight, ArrowUpLeft, ArrowUpRight, Languages, Moon, Sun } from '@lucide/astro';
import { getRoutes } from '../lib/site-routes';
import { type SiteLocale, getLocaleFromPath, getLocalizedPath, localeLabels, supportedLocales, stripLocalePrefix, t } from '../lib/i18n';
import SiteSearch from './SiteSearch.astro';
import GitHubStars from './GitHubStars.astro';
import { siteImage } from '../lib/site-images';

interface Props {
  locale?: SiteLocale;
}

const { locale: propLocale } = Astro.props;
const currentLocale = propLocale ?? getLocaleFromPath(Astro.url.pathname);
const routes = getRoutes(currentLocale);
const rawPath = stripLocalePrefix(Astro.url.pathname);

const activeRoute = rawPath === '/docs/architecture'
  ? 'architecture'
  : rawPath.startsWith('/docs') ? 'docs'
  : rawPath.startsWith('/marketplace/') ? 'marketplace'
  : routes.find((route) => route.href === Astro.url.pathname || route.id === (rawPath === '/' ? 'home' : rawPath.slice(1)))?.id ?? 'home';
const activeRouteIndex = Math.max(0, routes.findIndex((route) => route.id === activeRoute));
const images = await Promise.all(routes.map((route) => siteImage(`/images/nom/${route.image}`, [480, 960])));
const details = await Promise.all(routes.map((route) => siteImage(`/images/nom/${route.detail}`, [320, 640])));
---

<header class:list={['site-controls', { 'site-controls--compact': activeRoute === 'docs' }]}>
  <button class="site-icon menu-trigger" type="button" aria-label={t(currentLocale, 'nav.menuOpen')}
    title={t(currentLocale, 'nav.menuOpen')} aria-controls="route-menu" aria-expanded="false" data-menu-trigger>
    <i class="menu-trigger__line menu-trigger__line--top" aria-hidden="true"></i>
    <i class="menu-trigger__line menu-trigger__line--middle" aria-hidden="true"></i>
    <i class="menu-trigger__line menu-trigger__line--bottom" aria-hidden="true"></i>
  </button>
  <nav class="site-quick-nav" aria-label={t(currentLocale, 'nav.quick')}>
    {routes.map((route) => (
      <a href={route.href} aria-label={route.label}
        aria-current={route.id === activeRoute ? 'page' : undefined}>{route.short}</a>
    ))}
  </nav>
  <div class="site-controls__right">
    {activeRoute === 'home' && <GitHubStars />}
    <SiteSearch />
    <div class="locale-dropdown" data-locale-dropdown>
      <button class="site-icon locale-toggle" type="button" aria-label={t(currentLocale, 'nav.language')}
        title={t(currentLocale, 'nav.language')} aria-expanded="false" data-locale-toggle>
        <Languages size={20} stroke-width={1.6} aria-hidden="true" />
      </button>
      <div class="locale-menu" data-locale-menu hidden>
        {supportedLocales.map((loc) => (
          <a
            href={getLocalizedPath(Astro.url.pathname, loc)}
            class:list={['locale-menu__item', { 'locale-menu__item--active': loc === currentLocale }]}
            data-locale-choice={loc}
          >
            {localeLabels[loc]}
          </a>
        ))}
      </div>
    </div>
    <button class="site-icon theme-toggle" type="button" aria-label={t(currentLocale, 'nav.themeDark')}
      aria-pressed="false" title={t(currentLocale, 'nav.themeDark')} data-theme-toggle>
      <Sun class="theme-toggle__sun" size={22} stroke-width={1.6} aria-hidden="true" />
      <Moon class="theme-toggle__moon" size={22} stroke-width={1.6} aria-hidden="true" />
    </button>
  </div>
</header>

<dialog class="route-menu" id="route-menu" aria-label="页面导航" data-route-menu
  data-current-index={activeRouteIndex}>
  <button class="site-icon menu-close" type="button" aria-label="关闭页面导航" title="关闭页面导航" data-menu-close autofocus>
    <i class="menu-trigger__line menu-trigger__line--top" aria-hidden="true"></i>
    <i class="menu-trigger__line menu-trigger__line--middle" aria-hidden="true"></i>
    <i class="menu-trigger__line menu-trigger__line--bottom" aria-hidden="true"></i>
  </button>
  <div class="route-menu__surface">
  <div class="route-menu__header">
    <a class="route-menu__brand" href={getLocalizedPath('/', currentLocale)} data-menu-link>
      <img src="/brand/loom-logo.png" alt="" width="28" height="28" />
      <span>Loom Studio</span>
    </a>
    <span class="route-menu__edition" aria-hidden="true">{t(currentLocale, 'nav.indexEdition')}</span>
  </div>

  <div class="route-menu__scroll" data-menu-scroll tabindex="0" aria-label={t(currentLocale, 'nav.indexScroll')}>
    <div class="route-menu__track">
      <nav class="route-menu__stage" aria-label="页面入口">
        {routes.map((route, index) => (
          <a class="route-menu__entry"
            href={route.href} aria-current={route.id === activeRoute ? 'page' : undefined}
            data-route-index={index} data-composition={route.id} data-menu-link draggable="false" style={`--offset:${index - activeRouteIndex}`}>
            <span class="route-menu__meta">
              <span>{String(index + 1).padStart(2, '0')} / {route.id.toUpperCase()}</span>
              {route.id === activeRoute && <span>CURRENT</span>}
            </span>
            <span class="route-menu__image route-menu__image--main">
              <img src={images[index].src} srcset={images[index].srcSet}
                width={images[index].width} height={images[index].height}
                sizes="(max-width: 600px) 50vw, 480px" alt="" loading="lazy" decoding="async" draggable="false" />
            </span>
            <span class="route-menu__image route-menu__image--detail">
              <img src={details[index].src} srcset={details[index].srcSet}
                width={details[index].width} height={details[index].height}
                sizes="(max-width: 600px) 32vw, 300px" alt="" loading="lazy" decoding="async" draggable="false" />
            </span>
            <span class="route-menu__title">{route.label}<ArrowUpRight size={24} stroke-width={1.4} aria-hidden="true" /></span>
            <span class="route-menu__caption">{route.caption}</span>
          </a>
        ))}
      </nav>
    </div>
  </div>

  <div class="route-menu__footer">
    <div class="route-menu__locales">
      {supportedLocales.map((loc) => (
        <a
          href={getLocalizedPath(Astro.url.pathname, loc)}
          class:list={['route-menu__locale-item', { 'route-menu__locale-item--active': loc === currentLocale }]}
          data-menu-link
          data-locale-choice={loc}
        >
          {localeLabels[loc]}
        </a>
      ))}
    </div>
    <span class="route-menu__position"><b data-menu-counter>{String(activeRouteIndex + 1).padStart(2, '0')}</b> / {String(routes.length).padStart(2, '0')}</span>
    <div class="route-menu__steps">
      <button class="site-icon" type="button" aria-label={t(currentLocale, 'nav.previous')} title={t(currentLocale, 'nav.previous')} data-menu-previous>
        <ArrowUpLeft size={22} stroke-width={1.5} aria-hidden="true" />
      </button>
      <button class="site-icon" type="button" aria-label={t(currentLocale, 'nav.next')} title={t(currentLocale, 'nav.next')} data-menu-next>
        <ArrowDownRight size={22} stroke-width={1.5} aria-hidden="true" />
      </button>
    </div>
    <a class="route-menu__github" href="https://github.com/The-LoomStudio/LoomStudio" target="_blank" rel="noreferrer">
      GitHub <ArrowUpRight size={14} aria-hidden="true" />
    </a>
  </div>
  </div>
</dialog>

<script>
  const trigger = document.querySelector<HTMLButtonElement>('[data-menu-trigger]')!;
  const menu = document.querySelector<HTMLDialogElement>('[data-route-menu]')!;
  const scroller = menu.querySelector<HTMLElement>('[data-menu-scroll]')!;
  const surface = menu.querySelector<HTMLElement>('.route-menu__surface')!;
  const links = Array.from(menu.querySelectorAll<HTMLAnchorElement>('[data-route-index]'));
  const previous = menu.querySelector<HTMLButtonElement>('[data-menu-previous]')!;
  const next = menu.querySelector<HTMLButtonElement>('[data-menu-next]')!;
  const counter = menu.querySelector<HTMLElement>('[data-menu-counter]')!;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  let progress = Number(menu.dataset.currentIndex);
  let targetProgress = progress;
  let frame = 0;
  let lastTime = 0;
  let drag: { id: number; x: number; y: number; start: number } | null = null;
  let dragged = false;

  const syncThemeToggle = () => {
    if (!themeToggle) return;
    const dark = document.documentElement.dataset.theme === 'dark';
    const label = dark ? '切换至浅色模式' : '切换至暗色模式';
    themeToggle.setAttribute('aria-pressed', String(dark));
    themeToggle.setAttribute('aria-label', label);
    themeToggle.title = label;
  };
  themeToggle?.addEventListener('click', () => {
    const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = theme;
    document.documentElement.style.colorScheme = theme;
    document.querySelector<HTMLMetaElement>('[data-theme-color]')?.setAttribute('content', theme === 'dark' ? '#252b31' : '#82919b');
    try { localStorage.setItem('loom-site-theme', theme); } catch {}
    syncThemeToggle();
  });
  syncThemeToggle();

  const wrap = (value: number) => ((value % links.length) + links.length) % links.length;
  const offsetFrom = (index: number, position: number) => wrap(index - position + links.length / 2) - links.length / 2;
  const paint = () => {
    const position = reduceMotion.matches ? Math.round(progress) : progress;
    links.forEach((link, index) => link.style.setProperty('--offset', String(offsetFrom(index, position))));
    counter.textContent = String(wrap(Math.round(progress)) + 1).padStart(2, '0');
  };
  const render = (time: number) => {
    frame = 0;
    if (!menu.open || document.hidden) return;
    const elapsed = Math.min(time - lastTime, 64);
    lastTime = time;
    progress = reduceMotion.matches
      ? targetProgress
      : progress + (targetProgress - progress) * (1 - Math.exp(-elapsed / 200));
    if (Math.abs(targetProgress - progress) < 0.0005) {
      progress = targetProgress;
      paint();
      return;
    }
    paint();
    frame = requestAnimationFrame(render);
  };
  const requestUpdate = () => {
    if (menu.open && !document.hidden && !frame) {
      lastTime = performance.now();
      frame = requestAnimationFrame(render);
    }
  };
  const goTo = (index: number, immediate = false) => {
    targetProgress = index;
    if (immediate || reduceMotion.matches) {
      cancelAnimationFrame(frame);
      frame = 0;
      progress = targetProgress = wrap(index);
      paint();
    } else requestUpdate();
  };
  trigger.addEventListener('click', () => {
    menu.showModal();
    document.documentElement.setAttribute('data-menu-open', '');
    trigger.setAttribute('aria-expanded', 'true');
    goTo(Number(menu.dataset.currentIndex), true);
  });
  const closeMenu = () => {
    if (menu.hasAttribute('data-closing')) return;
    if (reduceMotion.matches) {
      menu.close();
      return;
    }
    menu.setAttribute('data-closing', '');
  };
  surface.addEventListener('animationend', (event) => {
    if (event.target === surface && menu.hasAttribute('data-closing')) menu.close();
  });
  menu.querySelector('[data-menu-close]')!.addEventListener('click', closeMenu);
  menu.addEventListener('cancel', (event) => {
    event.preventDefault();
    closeMenu();
  });
  menu.addEventListener('close', () => {
    cancelAnimationFrame(frame);
    frame = 0;
    drag = null;
    dragged = false;
    scroller.removeAttribute('data-dragging');
    menu.removeAttribute('data-closing');
    document.documentElement.removeAttribute('data-menu-open');
    trigger.setAttribute('aria-expanded', 'false');
    trigger.focus({ preventScroll: true });
  });
  previous.addEventListener('click', () => goTo(Math.round(targetProgress) - 1));
  next.addEventListener('click', () => goTo(Math.round(targetProgress) + 1));
  menu.addEventListener('keydown', (event) => {
    if (event.key === 'Tab') {
      const focusable = Array.from(menu.querySelectorAll<HTMLElement>('a[href], button:not(:disabled), [tabindex="0"]'));
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus({ preventScroll: true });
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus({ preventScroll: true });
      }
      return;
    }
    if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
    const movements: Record<string, number> = {
      ArrowLeft: -1, ArrowUp: -1, PageUp: -1,
      ArrowRight: 1, ArrowDown: 1, PageDown: 1,
      Home: -wrap(Math.round(targetProgress)), End: links.length - 1 - wrap(Math.round(targetProgress)),
    };
    const movement = movements[event.key];
    if (movement === undefined) return;
    event.preventDefault();
    const index = wrap(Math.round(targetProgress) + movement);
    links[index].focus({ preventScroll: true });
    goTo(index, true);
  });
  // Tab can focus an off-screen link; bring its image and title into the viewport.
  links.forEach((link, index) => {
    link.addEventListener('focus', () => {
      if (link.matches(':focus-visible')) goTo(index, true);
    });
  });
  menu.querySelectorAll<HTMLAnchorElement>('[data-menu-link]').forEach((link) => {
    link.addEventListener('click', (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const destination = new URL(link.href);
      if (destination.pathname === location.pathname && destination.search === location.search) {
        event.preventDefault();
        closeMenu();
        return;
      }
      document.documentElement.dataset.routeTransition = 'curtain';
      try {
        sessionStorage.setItem('loom-site-route-transition', JSON.stringify({
          direction: 'curtain', pathname: destination.pathname, createdAt: Date.now(),
        }));
      } catch {}
    });
  });
  // Only the open gallery consumes wheel input; page scrolling remains unchanged.
  scroller.addEventListener('wheel', (event) => {
    if (event.ctrlKey || event.metaKey || !event.cancelable) return;
    event.preventDefault();
    const unit = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? scroller.clientHeight : 1;
    const delta = Math.abs(event.deltaX) > Math.abs(event.deltaY) ? event.deltaX : event.deltaY;
    targetProgress += delta * unit * 0.00055;
    requestUpdate();
  }, { passive: false });
  scroller.addEventListener('pointerdown', (event) => {
    if (!event.isPrimary || event.button !== 0) return;
    dragged = false;
    drag = { id: event.pointerId, x: event.clientX, y: event.clientY, start: targetProgress };
  });
  scroller.addEventListener('pointermove', (event) => {
    if (!drag || drag.id !== event.pointerId) return;
    const dx = event.clientX - drag.x;
    const dy = event.clientY - drag.y;
    if (!dragged && Math.hypot(dx, dy) < 6) return;
    dragged = true;
    scroller.setPointerCapture(event.pointerId);
    scroller.setAttribute('data-dragging', '');
    // Touch scrolls vertically; only the presentation moves along the diagonal.
    targetProgress = drag.start - (event.pointerType === 'mouse' ? (dx + dy) * 0.0012 : dy * 0.002);
    requestUpdate();
  });
  const finishDrag = (event: PointerEvent) => {
    if (!drag || drag.id !== event.pointerId) return;
    if (scroller.hasPointerCapture(event.pointerId)) scroller.releasePointerCapture(event.pointerId);
    scroller.removeAttribute('data-dragging');
    drag = null;
  };
  scroller.addEventListener('pointerup', finishDrag);
  scroller.addEventListener('pointercancel', finishDrag);
  scroller.addEventListener('click', (event) => {
    if (!dragged) return;
    event.preventDefault();
    event.stopPropagation();
    dragged = false;
  }, { capture: true });
  scroller.addEventListener('dragstart', (event) => event.preventDefault());
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      cancelAnimationFrame(frame);
      frame = 0;
    } else requestUpdate();
  });
  const localeToggle = document.querySelector<HTMLButtonElement>('[data-locale-toggle]');
  const localeMenu = document.querySelector<HTMLElement>('[data-locale-menu]');
  if (localeToggle && localeMenu) {
    localeToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = !localeMenu.hidden;
      localeMenu.hidden = open;
      localeToggle.setAttribute('aria-expanded', String(!open));
    });
    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement)?.closest<HTMLAnchorElement>('[data-locale-choice]');
      if (target?.dataset.localeChoice) {
        try { localStorage.setItem('loom-site-locale', target.dataset.localeChoice); } catch {}
      }
      if (!localeMenu.hidden && !localeMenu.contains(e.target as Node)) {
        localeMenu.hidden = true;
        localeToggle.setAttribute('aria-expanded', 'false');
      }
    });
  }

  reduceMotion.addEventListener('change', () => {
    if (reduceMotion.matches && menu.hasAttribute('data-closing')) menu.close();
    else requestUpdate();
  });
</script>

<style is:global>
  .site-controls__right {
    position: absolute;
    top: 10px;
    right: 10px;
    display: flex;
    align-items: center;
    gap: 8px;
    pointer-events: auto;
  }
  .locale-dropdown {
    position: relative;
    pointer-events: auto;
  }
  .locale-toggle {
    position: relative;
    color: var(--loom-site-text);
  }
  .locale-menu {
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: 6px;
    padding: 6px;
    border-radius: 8px;
    background: var(--loom-site-bg-surface, #ffffff);
    border: 1px solid var(--loom-site-border, rgba(0,0,0,0.1));
    box-shadow: 0 4px 16px rgba(0,0,0,0.14);
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 100px;
    z-index: 450;
  }
  html[data-theme='dark'] .locale-menu {
    background: #1a1e22;
    border-color: rgba(255,255,255,0.12);
    box-shadow: 0 4px 16px rgba(0,0,0,0.4);
  }
  .locale-menu__item {
    display: block;
    padding: 6px 12px;
    font-size: 13px;
    color: var(--loom-site-text);
    text-decoration: none;
    border-radius: 4px;
    white-space: nowrap;
    text-align: left;
    transition: background 150ms ease;
  }
  .locale-menu__item:hover {
    background: var(--loom-site-accent-soft);
    color: var(--loom-site-accent-strong);
  }
  .locale-menu__item--active {
    font-weight: 600;
    color: var(--loom-site-accent);
  }
  .route-menu__locales {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-right: auto;
  }
  .route-menu__locale-item {
    font-size: 12px;
    color: var(--loom-site-text-muted);
    text-decoration: none;
    padding: 4px 8px;
    border-radius: 4px;
    border: 1px solid transparent;
  }
  .route-menu__locale-item:hover {
    color: var(--loom-site-text);
  }
  .route-menu__locale-item--active {
    color: var(--loom-site-text);
    border-color: var(--loom-site-border);
    font-weight: 600;
  }

  .site-controls {
    position: fixed;
    z-index: 400;
    inset: 0 0 auto;
    height: var(--loom-site-header-height);
    pointer-events: none;
  }
  .site-icon {
    display: grid;
    place-items: center;
    flex: 0 0 44px;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 4px;
    padding: 0;
    color: inherit;
    background: transparent;
    cursor: pointer;
    pointer-events: auto;
  }
  .site-icon:hover { color: var(--loom-site-accent-strong); background: var(--loom-site-accent-soft); }
  .site-icon:disabled { opacity: .25; cursor: default; background: transparent; }
  .menu-trigger { position: absolute; top: 10px; left: 10px; color: var(--loom-site-text); }
  .theme-toggle { position: relative; color: var(--loom-site-text); }
  .menu-trigger:hover, .menu-close:hover { background: transparent; }
  .menu-trigger__line {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 24px;
    height: 3px;
    border-radius: 999px;
    background: currentColor;
    filter: drop-shadow(0 2px 3px rgb(4 8 13 / .62));
    transform: translate(-50%, -50%) rotate(-38deg);
    transform-origin: center;
    transition: top 320ms ease, left 320ms ease, width 320ms ease, opacity 180ms ease, transform 360ms cubic-bezier(.55, 0, .1, 1);
  }
  .menu-trigger__line::before {
    position: absolute;
    inset: 0;
    content: '';
    background: var(--loom-site-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 220ms ease;
  }
  .menu-trigger:hover .menu-trigger__line::before,
  .menu-close:hover .menu-trigger__line::before { transform: scaleX(1); }
  .menu-trigger__line--top { top: 14px; left: 18px; width: 12px; }
  .menu-trigger__line--middle { top: 22px; }
  .menu-trigger__line--bottom { top: 30px; left: 26px; width: 12px; }
  .menu-close { position: absolute; z-index: 3; top: 10px; left: 10px; }
  .route-menu[open]:not([data-closing]) .menu-trigger__line--top {
    top: 22px; left: 22px; width: 24px;
    transform: translate(-50%, -50%) rotate(45deg);
    animation: menu-line-top 360ms cubic-bezier(.55, 0, .1, 1);
  }
  .route-menu[open]:not([data-closing]) .menu-trigger__line--middle {
    opacity: 0;
    transform: translate(-50%, -50%) rotate(-38deg) scaleX(0);
    animation: menu-line-middle 220ms ease;
  }
  .route-menu[open]:not([data-closing]) .menu-trigger__line--bottom {
    top: 22px; left: 22px; width: 24px;
    transform: translate(-50%, -50%) rotate(-45deg);
    animation: menu-line-bottom 360ms cubic-bezier(.55, 0, .1, 1);
  }
  @keyframes menu-line-top {
    from { top: 14px; left: 18px; width: 12px; transform: translate(-50%, -50%) rotate(-38deg); }
  }
  @keyframes menu-line-middle {
    from { opacity: 1; transform: translate(-50%, -50%) rotate(-38deg) scaleX(1); }
  }
  @keyframes menu-line-bottom {
    from { top: 30px; left: 26px; width: 12px; transform: translate(-50%, -50%) rotate(-38deg); }
  }
  .theme-toggle__moon { display: none; }
  html[data-theme='dark'] .theme-toggle__sun { display: none; }
  html[data-theme='dark'] .theme-toggle__moon { display: block; }
  .site-quick-nav {
    position: absolute;
    top: 62px;
    left: 22px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
    pointer-events: auto;
    font: 500 12px/1.5 var(--loom-site-font-sans);
    letter-spacing: 0;
    text-shadow: 0 1px 5px var(--loom-site-bg);
  }
  .site-quick-nav a { display: block; padding: 5px 0; color: var(--loom-site-text-muted); }
  .site-quick-nav a:hover, .site-quick-nav a[aria-current] { color: var(--loom-site-text); text-decoration: underline; text-underline-offset: 5px; }
  .site-controls--compact .site-quick-nav { flex-direction: column; gap: 3px; }
  body:has(.docs-shell) { --loom-site-header-height: 108px; }
  .architecture-page .site-quick-nav { flex-direction: column; gap: 3px; }
  .architecture-page .site-controls__right { right: 68px; }
  .architecture-page .site-controls .theme-toggle { top: auto; bottom: 14px; left: 10px; right: auto; position: fixed; }
  html[data-menu-open] .site-controls { visibility: hidden; }

  .route-menu {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
