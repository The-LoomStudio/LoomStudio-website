---
import PageArrivalScene from './logo-transition/PageArrivalScene';
import type { SiteLocale } from '../lib/i18n';
interface Props { locale: SiteLocale }
const { locale } = Astro.props;
const label = { 'zh-CN': '正在准备画面', en: 'Preparing the page', ja: 'ページを準備しています', ko: '페이지 준비 중' }[locale];
---
<div class="page-arrival" aria-label={label} aria-busy="true" data-page-arrival>
  <PageArrivalScene client:load />
</div>
<style is:global>
  .page-arrival { display: none; position: fixed; inset: 0; z-index: 10000; background: var(--loom-site-bg); }
  html[data-arrival] { overflow: hidden; }
  html[data-arrival] .page-arrival { display: block; }
  html[data-arrival='revealing'] .page-arrival { background: transparent; }
  .page-arrival__scene, .page-arrival .text-logo, .page-arrival .logo-transition { width: 100%; height: 100%; }
  .page-arrival .logo-transition { border: 0; border-radius: 0; aspect-ratio: auto; }
</style>
<script is:inline>
  if (!document.documentElement.dataset.routeTransition) {
    let seen = false;
    try { seen = sessionStorage.getItem('loom-site-arrival-seen') === '1'; } catch {}
    if (!seen) document.documentElement.dataset.arrival = 'loading';
  }
</script>
<script>
  const root = document.documentElement;
  document.addEventListener('click', event => {
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    if (!(event.target instanceof Element)) return;
    const link = event.target.closest<HTMLAnchorElement>('a[href]');
    if (!link || link.closest('[data-menu-link]') || link.hasAttribute('download') || (link.target && link.target !== '_self')) return;
    const destination = new URL(link.href);
    if (destination.origin !== location.origin || (destination.pathname === location.pathname && destination.search === location.search)) return;
    root.dataset.routeTransition = 'fade';
    try {
      sessionStorage.setItem('loom-site-route-transition', JSON.stringify({ direction: 'fade', pathname: destination.pathname, createdAt: Date.now() }));
    } catch {}
  });
  window.addEventListener('pageshow', event => {
    if (event.persisted) { delete root.dataset.arrival; }
    setTimeout(() => delete root.dataset.routeTransition, 900);
  });
</script>
