---
interface Props {
  initialMinutes?: number;
}

const { initialMinutes = 1110 } = Astro.props;
const stars = Array.from({ length: 72 }, (_, index) => ({
  x: (index * 47 + 11) % 100,
  y: (index * 29 + 7) % 92,
  size: 0.7 + ((index * 13) % 18) / 10,
  alpha: 0.38 + ((index * 17) % 52) / 100,
  duration: 3.2 + ((index * 11) % 62) / 10,
  delay: -((index * 7) % 54) / 10,
}));
---

<div class="sky-backdrop" data-sky-backdrop data-initial-minutes={initialMinutes} aria-hidden="true">
  <div class="sky-backdrop__tone" data-sky-tone></div>
  <div class="sky-backdrop__stars" data-sky-stars>
    {stars.map((star) => (
      <i
        style={`--star-x:${star.x}%;--star-y:${star.y}%;--star-size:${star.size}px;--star-alpha:${star.alpha};--star-duration:${star.duration}s;--star-delay:${star.delay}s`}
      ></i>
    ))}
  </div>
  <div class="sky-backdrop__clouds" data-sky-clouds></div>
</div>

<script>
  import { CloudField } from '../scripts/cloud-field';

  type RGB = readonly [number, number, number];
  type CloudTone = {
    brightness: number;
    contrast: number;
    grayscale: number;
    sepia: number;
    saturate: number;
    hue: number;
  };
  type Scene = {
    top: RGB;
    middle: RGB;
    bottom: RGB;
    cloud: CloudTone;
    cloudOpacity: number;
    starOpacity: number;
  };

  const scenes = {
    dawn: {
      top: [34, 48, 72],
      middle: [104, 119, 139],
      bottom: [190, 151, 146],
      cloud: { brightness: 0.76, contrast: 0.96, grayscale: 0.12, sepia: 0.22, saturate: 1.1, hue: -12 },
      cloudOpacity: 0.72,
      starOpacity: 0.28,
    },
    day: {
      top: [83, 117, 146],
      middle: [145, 169, 187],
      bottom: [205, 211, 214],
      cloud: { brightness: 1, contrast: 0.95, grayscale: 0, sepia: 0, saturate: 1, hue: 0 },
      cloudOpacity: 0.84,
      starOpacity: 0,
    },
    sunset: {
      top: [45, 56, 80],
      middle: [124, 91, 92],
      bottom: [202, 137, 117],
      cloud: { brightness: 0.68, contrast: 1, grayscale: 0.25, sepia: 0.38, saturate: 1.15, hue: -22 },
      cloudOpacity: 0.76,
      starOpacity: 0.16,
    },
    night: {
      top: [8, 14, 28],
      middle: [21, 34, 57],
      bottom: [42, 55, 76],
      cloud: { brightness: 0.28, contrast: 1.12, grayscale: 0.58, sepia: 0.04, saturate: 0.72, hue: 8 },
      cloudOpacity: 0.52,
      starOpacity: 0.96,
    },
    morning: {
      top: [91, 129, 156],
      middle: [178, 177, 184],
      bottom: [237, 190, 177],
      cloud: { brightness: 0.9, contrast: 0.94, grayscale: 0.06, sepia: 0.34, saturate: 1.25, hue: -18 },
      cloudOpacity: 0.8,
      starOpacity: 0.06,
    },
  } satisfies Record<string, Scene>;

  type SceneName = keyof typeof scenes;

  const backdrop = document.querySelector<HTMLElement>('[data-sky-backdrop]');
  const tone = backdrop?.querySelector<HTMLElement>('[data-sky-tone]');
  const stars = backdrop?.querySelector<HTMLElement>('[data-sky-stars]');
  const cloudViewport = backdrop?.querySelector<HTMLElement>('[data-sky-clouds]');

  if (backdrop && tone && stars && cloudViewport) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const cloudField = new CloudField(cloudViewport, {
      density: window.innerWidth < 720 ? 0.9 : 1.35,
      motionScale: 0.32,
    });
    cloudField.setPaused(true);
    cloudField.start();

    const skySections = Array.from(document.querySelectorAll<HTMLElement>('[data-sky-intro]'));
    const visibleSections = new Set<HTMLElement>();
    const timeStops: Array<{ hour: number; scene: SceneName }> = [
      { hour: 0, scene: 'night' },
      { hour: 4.5, scene: 'night' },
      { hour: 6, scene: 'dawn' },
      { hour: 8, scene: 'morning' },
      { hour: 11, scene: 'day' },
      { hour: 16, scene: 'day' },
      { hour: 18.5, scene: 'sunset' },
      { hour: 20.5, scene: 'night' },
      { hour: 24, scene: 'night' },
    ];
    let transitionFrame = 0;
    let minuteTimer = 0;
    let pageHidden = false;
    let userPaused = false;
    let motionActive = false;
    let storyTimeMinutes: number | undefined = Number(backdrop.dataset.initialMinutes);

    const mix = (from: number, to: number, amount: number) => from + (to - from) * amount;
    const mixRgb = (from: RGB, to: RGB, amount: number): RGB => [
      mix(from[0], to[0], amount),
      mix(from[1], to[1], amount),
      mix(from[2], to[2], amount),
    ];
    const mixCloud = (from: CloudTone, to: CloudTone, amount: number): CloudTone => ({
      brightness: mix(from.brightness, to.brightness, amount),
      contrast: mix(from.contrast, to.contrast, amount),
      grayscale: mix(from.grayscale, to.grayscale, amount),
      sepia: mix(from.sepia, to.sepia, amount),
      saturate: mix(from.saturate, to.saturate, amount),
      hue: mix(from.hue, to.hue, amount),
    });
    const mixScene = (from: Scene, to: Scene, amount: number): Scene => ({
      top: mixRgb(from.top, to.top, amount),
      middle: mixRgb(from.middle, to.middle, amount),
      bottom: mixRgb(from.bottom, to.bottom, amount),
      cloud: mixCloud(from.cloud, to.cloud, amount),
      cloudOpacity: mix(from.cloudOpacity, to.cloudOpacity, amount),
      starOpacity: mix(from.starOpacity, to.starOpacity, amount),
    });

    const formatCloudFilter = (cloud: CloudTone) => [
      `brightness(${cloud.brightness.toFixed(3)})`,
      `contrast(${cloud.contrast.toFixed(3)})`,
      `grayscale(${cloud.grayscale.toFixed(3)})`,
      `sepia(${cloud.sepia.toFixed(3)})`,
      `saturate(${cloud.saturate.toFixed(3)})`,
      `hue-rotate(${cloud.hue.toFixed(2)}deg)`,
    ].join(' ');

    const getTimeScene = (): Scene => {
      const now = new Date();
      const hour = storyTimeMinutes === undefined
        ? now.getHours() + now.getMinutes() / 60 + now.getSeconds() / 3600
        : storyTimeMinutes / 60;
      for (let index = 0; index < timeStops.length - 1; index += 1) {
        const from = timeStops[index];
        const to = timeStops[index + 1];
        if (hour <= to.hour) {
          const linearAmount = (hour - from.hour) / (to.hour - from.hour);
          const amount = linearAmount * linearAmount * (3 - 2 * linearAmount);
          return mixScene(scenes[from.scene], scenes[to.scene], amount);
        }
      }
      return scenes.night;
    };

    let currentScene = getTimeScene();
    let targetScene = currentScene;

    const paintScene = (scene: Scene) => {
      const color = (rgb: RGB) => `rgb(${rgb.map((channel) => channel.toFixed(2)).join(' ')})`;
      tone.style.background = `linear-gradient(180deg, ${color(scene.top)} 0%, ${color(scene.middle)} 58%, ${color(scene.bottom)} 100%)`;
      stars.style.opacity = String(scene.starOpacity);
      cloudField.setAtmosphere(formatCloudFilter(scene.cloud), scene.cloudOpacity);
      currentScene = scene;
    };

    const finishTransition = () => {
      window.cancelAnimationFrame(transitionFrame);
      transitionFrame = 0;
      paintScene(targetScene);
    };

    const updateScene = () => {
      window.cancelAnimationFrame(transitionFrame);
      transitionFrame = 0;
      targetScene = getTimeScene();
      if (!motionActive) {
        paintScene(targetScene);
        return;
      }

      // Capture the last painted scene so rapid input continues without stale callbacks.
      const from = currentScene;
      const to = targetScene;
      const startedAt = performance.now();
      const tick = (now: number) => {
        const progress = Math.min((now - startedAt) / 800, 1);
        const amount = 1 - (1 - progress) ** 3;
        paintScene(mixScene(from, to, amount));
        transitionFrame = progress < 1 ? window.requestAnimationFrame(tick) : 0;
      };
      transitionFrame = window.requestAnimationFrame(tick);
    };

    const syncSkyActivity = () => {
      const active = visibleSections.size > 0;
      motionActive = active && !document.hidden && !pageHidden && !reduceMotion.matches && !userPaused;
      backdrop.toggleAttribute('data-active', active);
      backdrop.toggleAttribute('data-motion-active', motionActive);
      cloudField.setPaused(!motionActive);
      if (!motionActive && transitionFrame) finishTransition();
    };

    const refreshVisibleSections = () => {
      visibleSections.clear();
      for (const section of skySections) {
        const rect = section.getBoundingClientRect();
        if (rect.top < window.innerHeight && rect.bottom > 0) visibleSections.add(section);
      }
      syncSkyActivity();
    };

    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        const section = entry.target as HTMLElement;
        if (entry.isIntersecting) visibleSections.add(section);
        else visibleSections.delete(section);
      }
      syncSkyActivity();
    });
    for (const section of skySections) observer.observe(section);

    const syncMinuteTimer = () => {
      window.clearInterval(minuteTimer);
      minuteTimer = 0;
      if (storyTimeMinutes === undefined && !document.hidden && !pageHidden) {
        minuteTimer = window.setInterval(updateScene, 60_000);
      }
    };

    const handleStoryTime = (event: Event) => {
      const minutes = (event as CustomEvent<{ minutes?: number | null }>).detail?.minutes;
      if (minutes === null) storyTimeMinutes = undefined;
      else if (typeof minutes === 'number' && Number.isFinite(minutes) && minutes >= 0 && minutes <= 1439) {
        storyTimeMinutes = minutes;
      } else return;
      syncMinuteTimer();
      updateScene();
    };

    const handleSkyMotion = (event: Event) => {
      const paused = (event as CustomEvent<{ paused?: boolean }>).detail?.paused;
      if (typeof paused !== 'boolean') return;
      userPaused = paused;
      syncSkyActivity();
    };

    const handleVisibility = () => {
      syncSkyActivity();
      syncMinuteTimer();
      if (!document.hidden && storyTimeMinutes === undefined) updateScene();
    };

    const handlePageHide = () => {
      pageHidden = true;
      syncSkyActivity();
      syncMinuteTimer();
    };

    const handlePageShow = () => {
      pageHidden = false;
      refreshVisibleSections();
      syncMinuteTimer();
      if (storyTimeMinutes === undefined) updateScene();
    };

    window.addEventListener('loom:story-time', handleStoryTime);
    window.addEventListener('loom:sky-motion', handleSkyMotion);
    document.addEventListener('visibilitychange', handleVisibility);
    reduceMotion.addEventListener('change', syncSkyActivity);
    // Preserve the cloud field and listeners while this document is in BFCache.
    window.addEventListener('pagehide', handlePageHide);
    window.addEventListener('pageshow', handlePageShow);

    paintScene(currentScene);
    refreshVisibleSections();
    syncMinuteTimer();
  }
</script>

<style is:global>
  .sky-backdrop {
    position: fixed;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    background: #223048;
    opacity: 0;
    transition: opacity 420ms ease;
  }

  .sky-backdrop[data-active] { opacity: 1; }

  .sky-backdrop__tone {
    position: absolute;
    z-index: 0;
    inset: -2px;
  }

  .sky-backdrop__stars {
    position: absolute;
    z-index: 1;
    inset: 0;
  }

  .sky-backdrop__stars > i {
    position: absolute;
    top: var(--star-y);
    left: var(--star-x);
    width: var(--star-size);
    height: var(--star-size);
    border-radius: 50%;
    opacity: var(--star-alpha);
    background: #f2f6ff;
    animation: sky-star-twinkle var(--star-duration) ease-in-out var(--star-delay) infinite alternate;
    animation-play-state: paused;
  }

  .sky-backdrop[data-motion-active] .sky-backdrop__stars > i { animation-play-state: running; }

  .sky-backdrop__clouds {
    position: absolute;
    z-index: 2;
    inset: -8%;
    overflow: hidden;
    perspective: 1000px;
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  .sky-cloud-world {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 512px;
    height: 512px;
    margin: -256px 0 0 -256px;
    transform-style: preserve-3d;
  }

  .sky-cloud-world div {
    transform-style: preserve-3d;
  }

  .sky-cloud-base {
    position: absolute;
    top: 256px;
    left: 256px;
    width: 20px;
    height: 20px;
    margin: -10px 0 0 -10px;
    transform-style: preserve-3d;
    will-change: transform;
  }

  .sky-cloud-layer {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 256px;
    height: 256px;
    margin: -128px 0 0 -128px;
    background: url('/images/cloud.png') center / contain no-repeat;
    transform-style: flat;
    backface-visibility: hidden;
    will-change: transform, opacity, filter;
  }

  @keyframes sky-star-twinkle {
    from { opacity: 0.18; transform: scale(0.74); }
    to { opacity: var(--star-alpha); transform: scale(1); }
  }

  @media (max-width: 720px) {
    .sky-backdrop__clouds { inset: -14%; }
    .sky-cloud-world { transform: scale(0.82); }
  }

  @media (prefers-reduced-motion: reduce) {
    .sky-backdrop__stars > i { animation: none; }
    .sky-backdrop { transition: none; }
  }
</style>
