---
import StudioDemo from './studio-demo/StudioDemo';
import AnimatedDetails from './motion/AnimatedDetails.astro';
import DeviceShowcase from './DeviceShowcase';
---

<div class="product-preview">
  <DeviceShowcase client:visible={{ rootMargin: '400px' }} />
  <AnimatedDetails class="component-draft"><span slot="summary">展开工作区演示</span><StudioDemo client:visible /></AnimatedDetails>
  <noscript>启用 JavaScript 后可体验工作区与 Agent 组件。</noscript>
</div>

<style>
  .product-preview { display: grid; gap: 32px; }
  .component-draft { margin-top: 18px; color: var(--loom-site-text-muted); font-size: 12px; }
  .component-draft :global(summary) { cursor: pointer; }
</style>
