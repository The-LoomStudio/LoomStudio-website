---
import StudioDemo from './studio-demo/StudioDemo';
import StoryDemo from './story-demo/StoryDemo';
---

<div class="product-preview">
  <StoryDemo client:load />
  <details class="component-draft"><summary>查看真实组件交互草稿</summary><StudioDemo client:idle /></details>
  <noscript>启用 JavaScript 后可体验工作区与 Agent 组件。</noscript>
</div>

<style>
  .product-preview { display: grid; gap: 32px; }
  .component-draft { margin-top: 18px; color: var(--loom-site-text-muted); font-size: 12px; }
  .component-draft summary { cursor: pointer; }
</style>
