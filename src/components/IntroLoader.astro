<div class="intro-loader" data-intro-loader aria-hidden="true">
  <div class="intro-loader__visual">
    <div class="intro-loader__glow" aria-hidden="true"></div>
    <img
      class="intro-loader__banner"
      src="/brand/banner.png"
      alt="Loom Studio"
      width="260"
      height="195"
      loading="eager"
      decoding="async"
    />
  </div>
  <div class="intro-loader__meta">
    <span>LOOM STUDIO</span>
    <small>编织世界，分支故事 · WEAVE WORLDS, BRANCH STORIES</small>
  </div>
</div>

<script>
  const loader = document.querySelector<HTMLElement>('[data-intro-loader]');
  let shouldPlay = true;

  try {
    shouldPlay = sessionStorage.getItem('loom-intro-seen') !== '1';
    if (shouldPlay) sessionStorage.setItem('loom-intro-seen', '1');
  } catch {}

  if (loader && shouldPlay && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    loader.dataset.active = '';
    const duration = 1800;
    const timer = window.setTimeout(() => {
      loader.remove();
    }, duration + 680);
    window.addEventListener('pagehide', () => window.clearTimeout(timer), { once: true });
  } else {
    loader?.remove();
  }
</script>

<style>
  .intro-loader {
    position: fixed;
    z-index: 1000;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    color: var(--loom-site-text);
    background: var(--loom-site-bg);
    visibility: hidden;
    pointer-events: none;
  }
  .intro-loader[data-active] {
    visibility: visible;
    pointer-events: auto;
    animation: intro-loader-curtain-out 680ms cubic-bezier(.55, 0, .1, 1) 1.5s forwards;
  }
  .intro-loader__visual {
    position: relative;
    display: grid;
    place-items: center;
    margin-bottom: 24px;
  }
  .intro-loader__glow {
    position: absolute;
    width: 280px;
    height: 280px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(160, 180, 205, 0.18) 0%, rgba(160, 180, 205, 0) 70%);
    filter: blur(20px);
    pointer-events: none;
    animation: intro-glow 2.4s ease-in-out infinite alternate;
  }
  .intro-loader__banner {
    display: block;
    width: clamp(200px, 30vw, 260px);
    height: auto;
    filter: drop-shadow(0 20px 48px rgba(0, 0, 0, 0.16));
    animation: intro-float 1.8s cubic-bezier(.16, 1, .3, 1) both;
  }
  .intro-loader__meta {
    display: grid;
    justify-items: center;
    gap: 8px;
    font-family: var(--loom-site-font-sans);
    letter-spacing: 0.32em;
    animation: intro-fade-up 800ms 200ms cubic-bezier(.16, 1, .3, 1) both;
  }
  .intro-loader__meta span { font-size: 13px; font-weight: 650; }
  .intro-loader__meta small { opacity: 0.65; font: 10px var(--loom-site-font-mono); letter-spacing: 0.16em; }

  @keyframes intro-float {
    0% { opacity: 0; transform: scale(0.92) translateY(12px); }
    100% { opacity: 1; transform: scale(1) translateY(0); }
  }
  @keyframes intro-fade-up {
    0% { opacity: 0; transform: translateY(8px); }
    100% { opacity: 1; transform: translateY(0); }
  }
  @keyframes intro-glow {
    0% { opacity: 0.4; transform: scale(0.95); }
    100% { opacity: 0.85; transform: scale(1.08); }
  }
  @keyframes intro-loader-curtain-out {
    0% { clip-path: inset(0 0 0 0); }
    100% { clip-path: inset(100% 0 0 0); visibility: hidden; }
  }
  @media (prefers-reduced-motion: reduce) {
    .intro-loader { display: none; }
  }
</style>
