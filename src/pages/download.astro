---
import { type SiteLocale, pageMeta } from '../lib/i18n';
import { downloadPageCopy } from '../data/download-page-copy';
import PortalLayout from '../layouts/PortalLayout.astro';
import DownloadConsole from '../components/download/DownloadConsole';
import AnimatedDetails from '../components/motion/AnimatedDetails.astro';
import NomSticker from '../components/NomSticker.astro';
import { ArrowUpRight, ChevronDown } from '@lucide/astro';
interface Props { locale?: SiteLocale; }
const { locale = 'zh-CN' } = Astro.props;
const copy = downloadPageCopy[locale];
const meta = pageMeta.download[locale];
---

<PortalLayout title={meta.title} description={meta.description} headline={meta.headline} intro={meta.intro} locale={locale}>
  <section class="portal-section portal-section--soft">
    <div class="container download-start" data-motion-group>
      <div class="download-start__intro" data-motion-reveal>
        <span class="portal-tag">{copy.source}</span>
        <h2 set:html={copy.terminal} />
        <p set:html={copy.requirements} />
        <p set:html={copy.firstRun} />
        <div class="download-links"><a href="https://git-scm.com/downloads" target="_blank" rel="noreferrer">{copy.git} <ArrowUpRight size={15} /></a><a href="https://nodejs.org/en/download" target="_blank" rel="noreferrer">{copy.node} <ArrowUpRight size={15} /></a></div>
      </div>
      <div class="download-terminal">
        <DownloadConsole locale={locale} client:load />
        <div class="download-tip"><NomSticker src="/images/nom/stickers/bust/tip.png" size="small" message={copy.tip} /></div>
      </div>
    </div>
  </section>
  <section class="portal-section">
    <div class="container">
      <div class="portal-section__heading"><div><h2>{copy.next}</h2></div><p set:html={copy.service} /></div>
      <div class="download-steps" data-motion-group>
        <article data-motion-reveal><span>{copy.step1}</span><h3>{copy.addressTitle}</h3><AnimatedDetails class="download-step"><span slot="summary">{copy.more}<ChevronDown size={14} aria-hidden="true" /></span><p set:html={copy.address} /></AnimatedDetails></article>
        <article data-motion-reveal><span>{copy.step2}</span><h3>{copy.modelTitle}</h3><AnimatedDetails class="download-step"><span slot="summary">{copy.more}<ChevronDown size={14} aria-hidden="true" /></span><p set:html={copy.models} /></AnimatedDetails></article>
        <article data-motion-reveal><span>{copy.step3}</span><h3>{copy.relaunchTitle}</h3><AnimatedDetails class="download-step"><span slot="summary">{copy.more}<ChevronDown size={14} aria-hidden="true" /></span><p set:html={copy.relaunch} /></AnimatedDetails></article>
      </div>
      <p class="download-note" set:html={copy.platformNote} />
    </div>
  </section>
  <section class="portal-section portal-section--soft">
    <div class="container download-details">
      <article data-motion-reveal><h2>{copy.backup}</h2><p set:html={copy.data} /><p set:html={copy.rebuild} /><p set:html={copy.updateSteps} /><p set:html={copy.localChanges} /></article>
      <article data-motion-reveal><h2>{copy.packages}</h2><p set:html={copy.release} /><div class="download-links"><a href="https://github.com/The-LoomStudio/LoomStudio/releases" target="_blank" rel="noreferrer">{copy.releases} <ArrowUpRight size={15} /></a><a href="https://github.com/The-LoomStudio/LoomStudio/blob/main/docs/guide/beta-release.md" target="_blank" rel="noreferrer">{copy.guide} <ArrowUpRight size={15} /></a></div><p set:html={copy.provider} /><div class="download-release-nom"><NomSticker src="/images/nom/stickers/fullbody/working.png" size="medium" /></div></article>
    </div>
  </section>
</PortalLayout>

<style>
  .download-start, .download-details { display: grid; grid-template-columns: 1fr 1fr; align-items: start; gap: clamp(28px, 5vw, 76px); }
  .download-start h2, .download-details h2 { font: 580 clamp(28px, 3.5vw, 42px)/1.3 var(--loom-site-font-display); margin: 24px 0; }
  .download-start p, .download-details p, .download-steps p, .download-note { color: var(--loom-site-text-muted); font-size: 14px; line-height: 1.9; overflow-wrap: anywhere; }
  .download-links { display: flex; flex-wrap: wrap; gap: 18px; margin-block: 24px; }
  .download-links a { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; text-decoration: underline; text-underline-offset: 5px; }
  .download-terminal { min-width: 0; }
  .download-tip { margin-top: 22px; }
  .download-release-nom { display: flex; justify-content: flex-end; margin-top: 24px; }
  pre { max-width: 100%; overflow-x: auto; padding: 20px 0; font: 12px/1.9 var(--loom-site-font-mono); }
  .download-start :global(code), .download-details :global(code), .download-steps :global(code), .download-note :global(code) { font-family: var(--loom-site-font-mono); }
  .download-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
  .download-steps article { border-top: 1px solid var(--loom-site-border); padding-top: 24px; }
  .download-steps span, .download-details small { font: 11px var(--loom-site-font-mono); color: var(--loom-site-text-muted); }
  .download-steps h3 { font-size: 20px; margin: 24px 0 14px; }
  .download-note { margin-top: 32px; font-size: 12px; }
  .download-details article { min-width: 0; }
  @media (max-width: 760px) { .download-start, .download-details, .download-steps { grid-template-columns: 1fr; } }
  .download-step :global(summary) { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 40px; cursor: pointer; font-size: 12px; list-style: none; color: var(--loom-site-text); }
  .download-step :global(summary::-webkit-details-marker) { display: none; }
  .download-step :global(summary) > span { display: flex; align-items: center; justify-content: space-between; width: 100%; }
</style>
