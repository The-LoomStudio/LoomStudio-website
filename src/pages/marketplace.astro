---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import NomSticker from '../components/NomSticker.astro';
import ExtensionArtwork from '../components/extensions/ExtensionArtwork.astro';
import { ArrowUpRight, ArrowRight, Puzzle } from '@lucide/astro';

const extensions = [
  {
    kind: 'bridge' as const, name: 'ST Data Bridge', label: '带着角色，继续出发',
    headline: '带着熟悉的角色走向下一站',
    copy: '把 SillyTavern 里的角色卡、世界书、预设与聊天记录带进 Loom Studio，让已有创作成为新的起点。',
    tags: ['角色卡迁移', '世界书与预设', 'EJS / MVU'], href: '/marketplace/st-data-bridge',
  },
  {
    kind: 'world' as const, name: 'The World', label: '装下一整个小世界',
    headline: '每一段故事都有自己的天色',
    copy: '记下时间、天气、地点与场景，让 AI 参与世界维护。推开工作台，也能看见故事里的黄昏。',
    tags: ['世界状态', '地点与场景', '天气氛围'], href: '/marketplace/the-world',
  },
];
---

<BaseLayout title="官方扩展 · Marketplace" description="探索 Loom Studio 官方扩展：用 ST Data Bridge 迁移 SillyTavern 资源，用 The World 为故事建立时间、地点、场景与天气。">
  <SiteHeader />
  <main class="marketplace">
    <header class="market-heading" data-motion-reveal>
      <span class="market-sticker"><Puzzle size={17} aria-hidden="true" />给工作台的一点新灵感</span>
      <h1>Extensions <span>/ 官方扩展</span></h1>
      <p>带来熟悉的角色，或为故事添上一整个世界。</p>
    </header>
    <section class="extension-board" data-motion-group aria-label="官方扩展">
      {extensions.map((extension) => (
        <article data-motion-reveal data-motion-feedback class:list={['extension-tile', `extension-tile--${extension.kind}`]}>
          <a class="extension-tile__art" href={extension.href} aria-label={`了解 ${extension.name}`}><ExtensionArtwork kind={extension.kind} compact /></a>
          <div class="extension-tile__copy">
            <span class="extension-tile__tag">{extension.label}</span>
            <span class="extension-tile__official">Loom Studio 官方扩展</span>
            <h2><a href={extension.href}>{extension.name}</a></h2>
            <h3>{extension.headline}</h3>
            <p>{extension.copy}</p>
            <ul>{extension.tags.map((tag) => <li>{tag}</li>)}</ul>
            <a class="extension-tile__link" data-motion-feedback href={extension.href}>认识 {extension.name}<ArrowUpRight size={18} aria-hidden="true" /></a>
          </div>
        </article>
      ))}
    </section>
    <aside class="market-help" data-motion-reveal>
      <div class="market-help__nom"><NomSticker src="/images/nom/stickers/bust/gift.png" size="small" /></div>
      <div class="market-help__copy"><h2>慢慢搭出自己的工作台</h2><p>从扩展中心安装与管理。每个扩展页都有功能介绍、使用步骤和源码入口。</p></div>
      <a href="/docs/concepts/extension-system">了解扩展体系 <ArrowRight size={16} aria-hidden="true" /></a>
    </aside>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .marketplace { width: min(1060px, calc(100% - 160px)); margin-inline: auto; padding: 118px 0 76px; font-family: var(--loom-site-note-body); }
  .market-heading { text-align: center; margin-bottom: 52px; }
  .market-sticker { display: inline-flex; align-items: center; gap: 9px; padding: 9px 16px; border-radius: 999px; background: var(--loom-site-note-yellow); color: var(--loom-site-note-ink); font-size: 12px; transform: rotate(-3deg); }
  .market-heading h1 { margin: 24px 0 12px; font: 500 38px/1.4 var(--loom-site-note-heading); }
  .market-heading h1 span { font-size: 23px; }
  .market-heading p { margin: 0; font-size: 14px; line-height: 1.8; color: var(--loom-site-text-muted); }
  .extension-board { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 34px; align-items: start; }
  .extension-tile { min-width: 0; background: var(--loom-site-note-paper); color: var(--loom-site-note-ink); border-radius: var(--loom-site-radius-lg); }
  .extension-tile--world { margin-top: 36px; }
  .extension-tile__art { display: block; border-radius: var(--loom-site-radius-lg) var(--loom-site-radius-lg) 0 0; }
  .extension-tile__copy { position: relative; padding: 0 32px 30px; }
  .extension-tile__tag { position: relative; display: table; margin: -16px 0 20px; padding: 8px 14px; border: 5px solid var(--loom-site-note-paper); border-radius: 999px; background: var(--loom-site-note-yellow); font-size: 11px; font-weight: 700; transform: rotate(-3deg); }
  .extension-tile--world .extension-tile__tag { background: var(--loom-site-note-lilac); transform: rotate(2deg); }
  .extension-tile__official { display: block; color: var(--loom-site-note-muted); font-size: 10px; }
  .extension-tile h2 { margin: 12px 0 14px; font: 500 clamp(28px, 3.2vw, 36px)/1.2 var(--loom-site-note-heading); }
  .extension-tile h3 { margin: 0 0 12px; font-size: 15px; line-height: 1.7; font-weight: 700; }
  .extension-tile p { margin: 0; color: var(--loom-site-note-muted); font-size: 14px; line-height: 1.9; }
  .extension-tile ul { display: flex; flex-wrap: wrap; gap: 7px; padding: 0; margin: 24px 0; list-style: none; }
  .extension-tile li { padding: 6px 10px; border-radius: 999px; background: #f5f3ef; color: var(--loom-site-note-muted); font-size: 10px; }
  .extension-tile__link { display: inline-flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 44px; padding: 10px 16px; border-radius: 999px; background: var(--loom-site-note-yellow); font-size: 12px; font-weight: 700; }
  .extension-tile--world .extension-tile__link { background: var(--loom-site-note-mint); }
  .extension-tile__link:hover { box-shadow: inset 0 0 0 1px currentColor; }
  .extension-tile :focus-visible { outline-color: var(--loom-site-note-ink); }
  .market-help { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; margin: 48px 0 0; padding: 26px 30px; background: var(--loom-site-note-lilac); color: var(--loom-site-note-ink); border-radius: var(--loom-site-radius-lg); }
  .market-help__nom { flex: none; }
  .market-help__copy { flex: 1 1 320px; }
  .market-help h2 { margin: 0 0 8px; font: 500 22px/1.4 var(--loom-site-note-heading); }
  .market-help p { margin: 0; color: var(--loom-site-note-muted); font-size: 12px; line-height: 1.9; }
  .market-help a { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-size: 12px; }
  .market-help a:focus-visible { outline-color: var(--loom-site-note-ink); }
  @media (max-width: 1100px) { .marketplace { width: calc(100% - 80px); } }
  @media (max-width: 760px) { .marketplace { width: calc(100% - 40px); padding-top: 110px; } .extension-board { grid-template-columns: 1fr; max-width: 510px; margin-inline: auto; gap: 32px; } .extension-tile--world { margin-top: 0; } .market-heading h1 { font-size: 32px; } .market-heading h1 span { font-size: 20px; } .extension-tile__copy { padding-inline: 24px; } .market-help { max-width: 510px; margin-inline: auto; padding: 24px; } }
</style>
