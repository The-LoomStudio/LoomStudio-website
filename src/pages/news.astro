---
import { ArrowUpRight, Check, ChevronDown, Feather, Megaphone, MoveDown, Sparkles } from '@lucide/astro';
import '../styles/news-motion.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AnimatedDetails from '../components/motion/AnimatedDetails.astro';
import NomSticker from '../components/NomSticker.astro';
import { type SiteLocale, getLocalizedPath } from '../lib/i18n';
import { newsCopy } from '../data/news-copy';
import { siteImage } from '../lib/site-images';

interface Props { locale?: SiteLocale; }
const { locale = 'zh-CN' } = Astro.props;
const copy = newsCopy[locale];
const [logo, cover, postcard] = await Promise.all([
  siteImage('/brand/banner.png', [360, 720, 1080], 90),
  siteImage('/images/nom/banners/nom-banner-015.png', [480, 960]),
  siteImage('/images/nom/banners/nom-banner-003.png', [480, 960]),
]);
const categories = {
 'zh-CN': [['all', '全部'], ['update', '更新'], ['fix', '修复'], ['journal', '随笔']],
 en: [['all', 'All'], ['update', 'Updates'], ['fix', 'Fixes'], ['journal', 'Notes']],
 ja: [['all', 'すべて'], ['update', '更新'], ['fix', '修正'], ['journal', '手記']],
 ko: [['all', '전체'], ['update', '업데이트'], ['fix', '수정'], ['journal', '노트']],
}[locale];
---

<BaseLayout locale={locale} title="News" description={copy.description}>
  <SiteHeader locale={locale} />
  <main class="news">
    <header class="news-heading" data-motion-reveal>
      <a href={getLocalizedPath('/', locale)} aria-label="Loom Studio" class="news-logo">
        <img src={logo.src} srcset={logo.srcSet} width={logo.width} height={logo.height}
          sizes="(max-width: 600px) 80vw, 420px" alt="Loom Studio" fetchpriority="high" />
      </a>
      <h1>News <span>{copy.subtitle}</span></h1>
      <p>{copy.intro}</p>
    </header>

    <fieldset class="news-filters">
      <legend class="sr-only">{copy.category}</legend>
      {categories.map(([value, label]) => (
        <label>
          <input type="radio" name="news-category" value={value} checked={value === 'all'} />
          <span>{label}</span>
        </label>
      ))}
    </fieldset>

    <section class="news-board" aria-label={copy.board}>
      <div class="news-motion-card" data-news-card data-category="update"><article id="news-diagonal-menu" class="news-item news-cover" data-category="update">
        <img class="news-cover__image" src={cover.src} srcset={cover.srcSet}
          width={cover.width} height={cover.height} sizes="(max-width: 680px) 90vw, 380px"
          alt={copy.coverAlt} />
        <div class="news-copy">
          <span class="news-tag">{copy.update}</span>
          <h2 set:html={copy.menuTitle} />
          <p>{copy.menuBody}</p>
          <footer><time datetime="2026-10-07">2026.10.07</time><Sparkles size={19} aria-hidden="true" /></footer>
        </div>
      </article></div>

      <div class="news-motion-card" data-news-card data-category="fix"><article id="news-touch-scroll" class="news-item news-ticket" data-category="fix">
        <header><span class="news-tag">{copy.fix}</span><MoveDown size={22} aria-hidden="true" /></header>
        <div class="ticket-perforation" aria-hidden="true"></div>
        <h2 set:html={copy.scrollTitle} />
        <p>{copy.scrollBody}</p>
        <div class="news-nom"><NomSticker src="/images/nom/stickers/bust/wink.png" size="small" /></div>
        <footer><time datetime="2026-10-07">2026.10.07</time></footer>
      </article></div>

      <div class="news-motion-card" data-news-card data-category="update"><article id="news-welcome-board" class="news-item news-welcome" data-category="update">
        <Megaphone size={32} stroke-width={1.7} aria-hidden="true" />
        <h2 set:html={copy.boardTitle} />
        <p>{copy.boardBody}</p>
        <div class="news-nom"><NomSticker src="/images/nom/stickers/fullbody/welcome.png" size="small" /></div>
        <footer><time datetime="2026-10-07">2026.10.07</time></footer>
      </article></div>

      <div class="news-motion-card" data-news-card data-category="journal"><article id="news-architecture-map" class="news-item news-postcard" data-category="journal">
        <span class="news-tape" aria-hidden="true"></span>
        <img src={postcard.src} srcset={postcard.srcSet} width={postcard.width} height={postcard.height}
          sizes="(max-width: 680px) 90vw, 380px" alt={copy.postcardAlt} loading="lazy" />
        <span class="news-tag">{copy.postcard}</span>
        <h2>{copy.mapTitle}</h2>
        <p>{copy.mapBody}</p>
        <a href={getLocalizedPath('/docs/architecture', locale)}>{copy.mapLink} <ArrowUpRight size={18} aria-hidden="true" /></a>
      </article></div>

      <div class="news-motion-card" data-news-card data-category="update"><article id="news-menu-details" class="news-item news-checklist" data-category="update">
        <span class="news-tag">{copy.interaction}</span>
        <h2 set:html={copy.detailsTitle} />
        <p>{copy.detailsBody}</p>
        <ul>
          <li><Check size={17} aria-hidden="true" />{copy.damping}</li>
          <li><Check size={17} aria-hidden="true" />{copy.parallax}</li>
          <li><Check size={17} aria-hidden="true" />{copy.loop}</li>
        </ul>
        <AnimatedDetails>
          <Fragment slot="summary">{copy.more} <ChevronDown size={18} aria-hidden="true" /></Fragment>
          <p>{copy.moreBody}</p>
        </AnimatedDetails>
        <footer><time datetime="2026-10-07">2026.10.07</time></footer>
      </article></div>

      <div class="news-motion-card" data-news-card data-category="journal"><article id="news-studio-layout" class="news-item news-note" data-category="journal">
        <Feather size={28} stroke-width={1.6} aria-hidden="true" />
        <span class="news-tag">{copy.design}</span>
        <h2 set:html={copy.layoutTitle} />
        <p>{copy.layoutBody}</p>
        <p>{copy.layoutEnd}</p>
        <footer><time datetime="2026-10-07">2026.10.07</time></footer>
      </article></div>
    </section>
  </main>
  <SiteFooter locale={locale} />
</BaseLayout>

<style>
  .news {
    --news-ink: var(--loom-site-note-ink);
    --news-muted: var(--loom-site-note-muted);
    --news-yellow: var(--loom-site-note-yellow);
    --news-heading: var(--loom-site-note-heading);
    width: min(1200px, calc(100% - 160px));
    margin: 0 auto;
    padding: 92px 0 28px;
    font-family: var(--loom-site-note-body);
    letter-spacing: 0;
  }
  .news-heading { text-align: center; margin-bottom: 30px; }
  .news-logo { display: block; width: min(420px, 100%); margin: auto; transition: transform 220ms ease; }
  .news-logo:hover { transform: rotate(-1deg); }
  .news-logo img { width: 100%; height: auto; }
  .news-heading h1 { margin: 14px 0 8px; font: 500 30px/1.4 var(--news-heading); }
  .news-heading h1 span { font-size: 19px; }
  .news-heading p { margin: 0; font-size: 14px; color: var(--loom-site-text-muted); }
  .news-filters { display: flex; justify-content: center; gap: 8px; margin: 0 0 42px; padding: 0; border: 0; }
  .news-filters label { position: relative; cursor: pointer; }
  .news-filters input, .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .news-filters span { display: block; padding: 9px 22px; border-radius: 999px; font-size: 14px; color: var(--loom-site-text); }
  .news-filters input:checked + span { background: var(--news-yellow); color: var(--news-ink); }
  .news-filters input:focus-visible + span { outline: 2px solid var(--loom-site-text); outline-offset: 4px; }
  .news-filters label:hover span { box-shadow: inset 0 0 0 1px currentColor; }
  .news-board { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: start; gap: 32px 30px; padding-top: 14px; }
  .news-item { position: relative; margin: 0; padding: 28px; background: var(--loom-site-note-paper); color: var(--news-ink); border-radius: 8px; overflow-wrap: anywhere; }
  .news-item h2 { margin: 16px 0 12px; font: 500 27px/1.3 var(--news-heading); }
  .news-item p { font-size: 14px; line-height: 1.85; color: var(--news-muted); margin: 0 0 16px; }
  .news-tag { display: inline-block; font-size: 11px; font-weight: 700; }
  .news-item footer { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-top: 26px; font-size: 10px; color: var(--news-muted); }
  .news-nom { display: flex; justify-content: flex-end; margin-top: 12px; padding: 6px 4px; }
  .news-cover { padding: 0; }
  .news-cover__image { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 8px 8px 0 0; }
  .news-copy { padding: 30px 26px 24px; position: relative; }
  .news-copy > .news-tag { margin-top: -47px; margin-bottom: 4px; position: relative; display: table; padding: 9px 12px; background: var(--news-yellow); border: 5px solid white; border-radius: 999px; transform: rotate(-3deg); }
  .news-ticket { background: #fafcfb; }
  .news-ticket header { display: flex; justify-content: space-between; align-items: center; }
  .ticket-perforation { position: relative; border-top: 2px dashed #bccac6; margin: 26px -4px; }
  .ticket-perforation::before, .ticket-perforation::after { content: ""; position: absolute; top: -13px; width: 24px; height: 24px; background: var(--loom-site-bg); border-radius: 50%; }
  .ticket-perforation::before { left: -36px; }
  .ticket-perforation::after { right: -36px; }
  .news-welcome { background: var(--loom-site-note-mint); padding-top: 38px; border-radius: 8px 8px 32px 8px; }
  .news-postcard { padding: 14px 14px 26px; transform: rotate(-1.5deg); text-align: center; }
  .news-postcard img { width: 100%; height: auto; aspect-ratio: 5 / 4; object-fit: cover; margin-bottom: 20px; }
  .news-postcard h2 { font-size: 24px; }
  .news-postcard p { padding: 0 8px; }
  .news-postcard a { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; border-bottom: 1px solid #92a39b; padding-bottom: 4px; }
  .news-tape { position: absolute; z-index: 1; width: 88px; height: 26px; left: calc(50% - 44px); top: -11px; background: #f4d06fe6; transform: rotate(4deg); }
  .news-checklist { padding-top: 30px; }
  .news-checklist ul { list-style: none; padding: 0; margin: 22px 0; }
  .news-checklist li { display: flex; align-items: center; gap: 9px; font-size: 13px; margin: 12px 0; }
  .news-checklist li svg { flex-shrink: 0; color: #427562; }
  .news-checklist details { border-top: 1px dashed #c7cccf; border-bottom: 1px dashed #c7cccf; }
  .news-checklist :global(summary) { display: flex; align-items: center; justify-content: space-between; gap: 12px; cursor: pointer; padding: 16px 0; font-size: 13px; list-style: none; }
  .news-checklist :global(summary::-webkit-details-marker) { display: none; }
  .news-checklist :global(summary) svg { flex-shrink: 0; transition: transform 180ms ease; }
  .news-checklist details[open] :global(summary) svg { transform: rotate(180deg); }
  .news-checklist details p { font-size: 13px; }
  .news-note { background: var(--loom-site-note-lilac); border-radius: 8px 30px 8px 8px; }
  .news-note > svg { display: block; margin-bottom: 18px; }
  .news-note h2 { font-size: 25px; }
  .news:not([data-motion-filters]):has(input[value="update"]:checked) .news-motion-card:not([data-category="update"]),
  .news:not([data-motion-filters]):has(input[value="fix"]:checked) .news-motion-card:not([data-category="fix"]),
  .news:not([data-motion-filters]):has(input[value="journal"]:checked) .news-motion-card:not([data-category="journal"]) { display: none; }
  @media (max-width: 1100px) {
    .news { width: calc(100% - 80px); padding-top: 108px; }
    .news-board { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 680px) {
    .news { width: calc(100% - 40px); }
    .news-logo { width: min(340px, 100%); }
    .news-board { grid-template-columns: minmax(0, 1fr); max-width: 440px; margin: auto; }
    .news-filters span { padding: 9px 18px; }
    .news-heading h1 { font-size: 27px; }
    .news-heading p { font-size: 12px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .news-logo, .news-checklist :global(summary) svg { transition: none; }
  }
</style>

<script>
  import '../scripts/news-filters';
</script>
