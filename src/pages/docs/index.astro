---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { ArrowRight } from '@lucide/astro';

const cards = [
  { href: '/docs/architecture', tag: 'ARCHITECTURE', title: '开发者架构地图', copy: '追踪文件导入、剧情创建、模型与工具如何连接本地数据，查看每一步的职责与边界' },
  { href: '/docs/getting-started', tag: 'START', title: '快速开始', copy: '了解当前站点与桌面应用的边界，建立 Loom Studio 的第一张概念地图' },
  { href: '/docs/concepts/narrative-timeline', tag: 'STORY', title: 'Narrative Timeline', copy: '正文节点与分支保存故事；Timeline 根 Session 承接输入，普通回复仍留在工作记录' },
  { href: '/docs/concepts/agent-sessions', tag: 'WORK', title: 'Agent Session', copy: '区分普通工作 Session 与 Timeline 根 Session，以及各自的 Transcript 和上下文' },
  { href: '/docs/concepts/prompt-build', tag: 'CONTEXT', title: 'Prompt Build', copy: 'Runtime 组合来源，按 Activation 与 DFS 编排；可选处理器加工正文并留下构建观察' },
  { href: '/docs/concepts/composition-skeleton', tag: 'SKELETON', title: '设定层与装配骨架', copy: '存储拓扑与装配投影分离，让世界设定与运行时上下文井然有序' },
  { href: '/docs/concepts/extension-system', tag: 'EXTENSION', title: '插件与扩展体系', copy: '安装包、模块与实例分层；扩展权限受 Host API 约束，服务端模块仍是可信代码' },
  { href: '/docs/concepts/trace-and-audit', tag: 'EXPLAIN', title: '可解释性与 Trace', copy: '查看构建投影、Provider Observation、运行记录与数据变更；各记录范围不同' },
  { href: '/docs/concepts/local-first', tag: 'LOCAL', title: '本地数据边界', copy: '工作区数据保存在本机；发送给外部模型的上下文取决于所配置的 Provider' },
];
const overviewHeadings = [
  { depth: 2, slug: '从故事开始', text: '从故事开始' },
  { depth: 2, slug: '最小概念图', text: '最小概念图' },
  { depth: 2, slug: '当前建设状态', text: '当前建设状态' },
];
---

<DocsLayout
  frontmatter={{ title: '文档概览', description: '从 Narrative、Agent Session 与 Prompt Build 三条主线，理解 Loom Studio 如何支撑长篇角色扮演与深度叙事' }}
  headings={overviewHeadings}
>
  <section class="docs-intro" data-motion-reveal>
    <h2 id="从故事开始">从故事开始</h2>
    <p>Loom Studio 是面向深度长篇角色扮演与互动叙事的桌面创作工具，故事可以持续生长，Agent 可以在幕后推演，提示词装配可通过已有构建记录检查</p>
    <blockquote data-callout="boundary">当前公开文档由网站仓库独立维护，不自动发布产品仓库的内部规范。页面示意图和产品演示也不连接真实工作区或 Provider。</blockquote>
  </section>

  <section class="docs-card-grid" data-motion-group>
    {cards.map((card) => (
      <a href={card.href} data-motion-reveal data-motion-feedback>
        <span>{card.tag}</span>
        <h3>{card.title}</h3>
        <p>{card.copy}</p>
        <ArrowRight class="card-arrow" size={17} stroke-width={1.8} />
      </a>
    ))}
  </section>

  <h2 id="最小概念图">最小概念图</h2>
  <pre><code>Narrative Timeline
  正文节点与分支；输入先提交
        ↕ Timeline 根 Session（同 ID）承接输入
Agent Session / Transcript
  记录消息、工具、观察与工作历史
        ↓ Narrative / Session History 投影
Prompt Build
  来源组合 → 可选正文处理 → Activation / DFS 编排
        ├─ messages + Native tools → 外部 Provider
        └─ build / provider / run 观察与数据变更</code></pre>

  <h2 id="当前建设状态">当前建设状态</h2>
  <table>
    <thead><tr><th>区域</th><th>当前状态</th><th>边界</th></tr></thead>
    <tbody>
      <tr><td>产品发布页</td><td>首版基建</td><td>静态展示，不接真实工作区</td></tr>
      <tr><td>公开文档</td><td>概念页、架构地图与站内索引</td><td>由网站仓库维护，不自动同步内部文档</td></tr>
      <tr><td>下载与 Changelog</td><td>源码启动说明已发布</td><td>预编译安装包仍由 GitHub Releases 承载</td></tr>
      <tr><td>Cloudflare Pages</td><td>暂缓</td><td>本地确认后再配置</td></tr>
    </tbody>
  </table>
</DocsLayout>

<style>
  .docs-card-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 36px 0 58px;
  }
  .docs-card-grid a {
    position: relative;
    min-height: 190px;
    display: grid;
    align-content: start;
    border-radius: 18px;
    padding: 24px;
    background: var(--loom-site-surface);
    transition: background 160ms ease;
  }
  .docs-card-grid a:hover {
    background: var(--loom-site-surface-raised);
  }
  .docs-card-grid span {
    color: var(--loom-site-accent);
    font: 9px var(--loom-site-font-mono);
    letter-spacing: 0.14em;
  }
  .docs-card-grid h3 {
    margin: 28px 0 10px;
    color: var(--loom-site-text);
    font: 580 20px var(--loom-site-font-display);
  }
  .docs-card-grid p {
    margin: 0;
    color: var(--loom-site-text-muted);
    font-size: 12px;
    line-height: 1.7;
  }
  .docs-card-grid :global(.card-arrow) {
    position: absolute;
    right: 20px;
    bottom: 16px;
    color: var(--loom-site-text-subtle);
  }
  @media (max-width: 620px) {
    .docs-card-grid { grid-template-columns: 1fr; }
  }
</style>
