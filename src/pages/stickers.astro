---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import NomStickerGallery from '../components/nom-stickers/NomStickerGallery';
import entries from '../data/nom-stickers.json';
import { siteImage } from '../lib/site-images';
import { type SiteLocale, getLocaleFromPath, getStickersCopy, pageMeta } from '../lib/i18n';
import { Download, ArrowDown } from '@lucide/astro';
import { stat } from 'node:fs/promises';

interface Props {
  locale?: SiteLocale;
}

const { locale: propLocale } = Astro.props;
const locale = propLocale ?? getLocaleFromPath(Astro.url.pathname);
const meta = pageMeta.stickers[locale] ?? pageMeta.stickers['zh-CN'];
const copy = getStickersCopy(locale);
const packSize = ((await stat('public/downloads/nom-stickers-512.zip')).size / 1024 / 1024).toFixed(1);
const stickers = await Promise.all(entries.map(async entry => ({
  ...entry, image: await siteImage(`/images/nom/stickers/${entry.file}`, [160, 320, 640], 90),
})));
---

<BaseLayout title={meta.title} description={meta.description} locale={locale}>
  <SiteHeader locale={locale} />
  <main class="nom-page">
    <header class="nom-page__hero" data-motion-group>
      <div data-motion-reveal>
        <p class="eyebrow">{copy.hero.eyebrow}</p>
        <h1 set:html={copy.hero.title} />
        <p class="nom-page__intro" set:html={copy.hero.intro} />
      </div>
      <aside class="nom-pack" data-motion-reveal aria-label={copy.pack.downloadButton}>
        <span class="nom-pack__edition">{copy.pack.edition}</span>
        <p><b>{entries.length}</b><span set:html={copy.pack.countSuffix} /></p>
        <a class="button button--primary" data-motion-feedback href="/downloads/nom-stickers-512.zip" download><Download size={18} aria-hidden="true" /> {copy.pack.downloadButton}</a>
        <small set:html={copy.pack.details(packSize)} />
      </aside>
    </header>
    <div class="nom-page__divider"><span>{copy.divider}</span><ArrowDown size={16} aria-hidden="true" /></div>
    <NomStickerGallery entries={stickers} locale={locale} client:load />
    <noscript><p>{copy.noscript}</p></noscript>
  </main>
  <SiteFooter locale={locale} />
</BaseLayout>

<style>
  .nom-page { width: min(1120px, calc(100% - 180px)); margin: auto; padding-top: calc(var(--loom-site-header-height) + 100px); }
  .nom-page__hero { display: grid; grid-template-columns: 1.4fr .75fr; gap: 70px; align-items: center; padding-bottom: 64px; }
  h1 { margin: 22px 0; font: 550 clamp(40px, 5.6vw, 72px)/1.18 var(--loom-site-font-display); letter-spacing: -.04em; }
  .nom-page__intro { margin: 0; color: var(--loom-site-text-muted); font-size: 15px; line-height: 1.95; }
  .nom-pack { position: relative; padding: 30px; border-radius: 8px 26px 26px 26px; background: var(--loom-site-note-paper); color: var(--loom-site-note-ink); transform: rotate(2deg); box-shadow: 0 12px 35px rgb(10 20 30 / .08); }
  .nom-pack__edition { color: var(--loom-site-note-muted); font: 10px var(--loom-site-font-mono); letter-spacing: .1em; }
  .nom-pack > p { display: flex; gap: 20px; align-items: center; margin: 22px 0; }
  .nom-pack b { font: 550 76px/1 var(--loom-site-font-display); letter-spacing: -.06em; }
  .nom-pack p span { font-size: 14px; line-height: 1.7; }
  .nom-pack .button { width: 100%; border: 0; background: #293238; color: white; gap: 10px; }
  .nom-pack .button:hover { background: #43515b; }
  .nom-pack small { display: block; margin-top: 14px; color: var(--loom-site-note-muted); font-size: 11px; line-height: 1.8; text-align: center; }
  .nom-page__divider { display: flex; justify-content: space-between; gap: 20px; padding: 18px 0; border-top: 1px solid var(--loom-site-border-strong); color: var(--loom-site-text-muted); font-size: 12px; }
  @media (max-width: 1100px) { .nom-page { width: min(960px, calc(100% - 48px)); } }
  @media (max-width: 700px) {
    .nom-page { width: calc(100% - 28px); padding-top: 146px; }
    .nom-page__hero { grid-template-columns: 1fr; gap: 36px; padding-bottom: 44px; }
    .nom-pack { transform: none; padding: 24px; }
    .nom-pack > p { margin: 16px 0; }
    .nom-pack b { font-size: 58px; }
  }
</style>
