---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { ArrowRight } from '@lucide/astro';
import { type SiteLocale, pageMeta, getLocalizedPath } from '../../../lib/i18n';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'ja' } },
    { params: { lang: 'ko' } },
  ];
}

const { lang } = Astro.params;
const currentLocale = lang as SiteLocale;
const meta = pageMeta.docs[currentLocale] ?? pageMeta.docs['en'];

interface CardItem {
  href: string;
  tag: string;
  title: string;
  copy: string;
}

const cardsData: Record<string, CardItem[]> = {
  'en': [
    { href: '/docs/architecture', tag: 'ARCHITECTURE', title: 'Architecture Map', copy: 'Trace file import, narrative timeline, model and tools connection to local data.' },
    { href: '/docs/getting-started', tag: 'START', title: 'Quick Start', copy: 'Understand boundaries between website and desktop app, build your first mental map.' },
    { href: '/docs/concepts/narrative-timeline', tag: 'STORY', title: 'Narrative Timeline', copy: 'Why prose should never just be chat logs, and how worldlines stay independent.' },
    { href: '/docs/concepts/agent-sessions', tag: 'WORK', title: 'Agent Session', copy: 'How agent reasoning, tools, and history serve the story without polluting it.' },
    { href: '/docs/concepts/prompt-build', tag: 'CONTEXT', title: 'Prompt Build', copy: 'Structure, Source, Activation, and Trace forming an explainable context.' },
    { href: '/docs/concepts/composition-skeleton', tag: 'SKELETON', title: 'Setting Layer & Skeleton', copy: 'Separating storage topology and assembly projection for clean context.' },
    { href: '/docs/concepts/extension-system', tag: 'EXTENSION', title: 'Extension System', copy: 'Package, Module, and Instance layers keeping capability contribution safe.' },
    { href: '/docs/concepts/trace-and-audit', tag: 'EXPLAIN', title: 'Explainability & Trace', copy: 'End-to-end factual chain and Changeset audit, eliminating black boxes.' },
    { href: '/docs/concepts/local-first', tag: 'LOCAL', title: 'Local Data Boundary', copy: 'Local workspace centered, privacy first, data never uploaded to 3rd party servers.' },
  ],
  'ja': [
    { href: '/docs/architecture', tag: 'ARCHITECTURE', title: 'アーキテクチャマップ', copy: 'ファイル取り込み、物語生成、モデルやツールがローカルデータと接続する境界を俯瞰。' },
    { href: '/docs/getting-started', tag: 'START', title: 'クイックスタート', copy: 'Web サイトとデスクトップアプリの境界を把握し、Loom Studio の全体像を掴む。' },
    { href: '/docs/concepts/narrative-timeline', tag: 'STORY', title: 'Narrative Timeline', copy: 'なぜ本文が単なるチャット履歴であってはならないのか、世界線の独立性を保つ仕組み。' },
    { href: '/docs/concepts/agent-sessions', tag: 'WORK', title: 'Agent Session', copy: 'エージェントの推論やツール実行が、物語を邪魔することなく奉仕する構造。' },
    { href: '/docs/concepts/prompt-build', tag: 'CONTEXT', title: 'Prompt Build', copy: 'Structure、Source、Activation、Trace が織りなす明瞭で追跡可能なコンテキスト。' },
    { href: '/docs/concepts/composition-skeleton', tag: 'SKELETON', title: '設定層とアセンブリ骨格', copy: 'ストレージ構成と投影の分離により、世界観設定と実行時文脈を秩序正しく保つ。' },
    { href: '/docs/concepts/extension-system', tag: 'EXTENSION', title: '拡張エコシステム', copy: 'Package、Module、Instance の 3 層モデルで機能貢献を安全に制御。' },
    { href: '/docs/concepts/trace-and-audit', tag: 'EXPLAIN', title: '説明可能性と Trace', copy: '端から端までの事実連鎖と Changeset 監査により、ブラックボックスを排除。' },
    { href: '/docs/concepts/local-first', tag: 'LOCAL', title: 'ローカルファーストの境界', copy: 'ローカル作業領域を中心に据え、完全なプライバシーを保護。外部送信はゼロ。' },
  ],
  'ko': [
    { href: '/docs/architecture', tag: 'ARCHITECTURE', title: '아키텍처 맵', copy: '파일 가져오기, 서사 생성, 모델 및 도구가 로컬 데이터와 연결되는 경계를 살펴봅니다.' },
    { href: '/docs/getting-started', tag: 'START', title: '빠른 시작', copy: '웹사이트와 데스크톱 앱의 경계를 이해하고 Loom Studio의 첫 번째 개념도를 형성합니다.' },
    { href: '/docs/concepts/narrative-timeline', tag: 'STORY', title: 'Narrative Timeline', copy: '왜 본문이 단순한 대화 기록에 머물러선 안 되는지, 세계선을 독립적으로 유지하는 방법.' },
    { href: '/docs/concepts/agent-sessions', tag: 'WORK', title: 'Agent Session', copy: '에이전트의 추론과 도구 실행이 이야기를 오염시키지 않고 뒷받침하는 방식.' },
    { href: '/docs/concepts/prompt-build', tag: 'CONTEXT', title: 'Prompt Build', copy: 'Structure, Source, Activation, Trace가 구성하는 명확하고 추적 가능한 컨텍스트.' },
    { href: '/docs/concepts/composition-skeleton', tag: 'SKELETON', title: '설정 계층 및 조립 골격', copy: '저장 토폴로지와 조립 투영의 분리로 세계 설정과 런타임 문맥을 질서 있게 유지.' },
    { href: '/docs/concepts/extension-system', tag: 'EXTENSION', title: '확장 시스템', copy: 'Package, Module, Instance 3계층 모델로 확장 기여를 안전하게 통제.' },
    { href: '/docs/concepts/trace-and-audit', tag: 'EXPLAIN', title: '설명 가능성과 Trace', copy: '엔드투엔드 사실 체인과 Changeset 감사를 통해 블랙박스를 제거.' },
    { href: '/docs/concepts/local-first', tag: 'LOCAL', title: '로컬 데이터 경계', copy: '로컬 작업 영역 중심, 프라이버시 우선, 데이터의 외부 전송 배제.' },
  ],
};

const cards = (cardsData[currentLocale] ?? cardsData['en']).map((c: CardItem) => ({
  ...c,
  href: getLocalizedPath(c.href, currentLocale),
}));

interface SectionText {
  introHeading: string;
  introDesc: string;
  callout: string;
  diagramHeading: string;
  diagram: string;
  statusHeading: string;
  tableHeaders: string[];
  tableRows: string[][];
}

const sectionTextsData: Record<string, SectionText> = {
  'en': {
    introHeading: 'Starting with Story',
    introDesc: 'Loom Studio is a desktop creation environment crafted for deep, long-form roleplay and interactive fiction. Stories grow continuously, agents reason backstage, and prompt assembly remains completely transparent and auditable.',
    callout: 'Public documentation currently highlights external product concepts. Internal design specifications are preserved in the core workspace.',
    diagramHeading: 'Minimal Mental Map',
    diagram: `Narrative Timeline
  Persists only controlled, committed prose
        ↕ Associated, not co-rooted
Agent Session
  Holds messages, reasoning, tools & working history
        ↓ Constructs current turn input
Prompt Build
  Select Source → Allocate Mount & Slots → Activation → Trace
        ↓ Compiled Messages
Provider`,
    statusHeading: 'Current Roadmap & Status',
    tableHeaders: ['Area', 'Status', 'Boundary'],
    tableRows: [
      ['Product Portal', 'Foundation Built', 'Static presentation, no direct workspace bind'],
      ['Public Documentation', 'Initial Concepts', 'Maintained independently, private specs kept internal'],
      ['Downloads & Changelog', 'Upcoming Phase', 'Installers hosted directly on GitHub Releases'],
      ['Edge Deployment', 'Deferred', 'Local testing prioritized before cloud rollout'],
    ],
  },
  'ja': {
    introHeading: '物語から始まる',
    introDesc: 'Loom Studio は、長編ロールプレイと奥深いインタラクティブ叙事のために設計されたデスクトップ創作環境です。物語は継続的に紡がれ、エージェントは舞台裏で推論し、プロンプトのアセンブリは常に完全に追跡可能です。',
    callout: '公開ドキュメントは外部利用者に適した製品概念のみを掲載しています。内部仕様はワークスペース内で安全に管理されます。',
    diagramHeading: '最小限の概念マップ',
    diagram: `Narrative Timeline
  承認・コミットされた本文のみを保持
        ↕ 関連するが、ルーツは共有しない
Agent Session
  メッセージ、推論、ツール、作業履歴を保持
        ↓ 今回のターン入力を構築
Prompt Build
  Source 選択 → スロット・マウント割り当て → Activation → Trace
        ↓ コンパイル済みメッセージ
Provider`,
    statusHeading: '現在の構築状況',
    tableHeaders: ['領域', '現在の状態', '境界・制約'],
    tableRows: [
      ['製品ポータル', '初版基盤完成', '静的プレゼンテーション、実作業領域には直接非接続'],
      ['公開ドキュメント', '初期コンセプト整備', '独立して管理、内部仕様は自動公開しない'],
      ['ダウンロード & 更新履歴', '次期フェーズ', 'インストーラーは GitHub Releases にて配布'],
      ['エッジ配信設定', '保留', 'ローカルでの動作確認完了後に順次整備'],
    ],
  },
  'ko': {
    introHeading: '이야기에서 시작하다',
    introDesc: 'Loom Studio는 깊이 있는 장편 롤플레잉 및 인터랙티브 서사를 위해 제작된 데스크톱 창작 도구입니다. 이야기는 끊임없이 이어지고, 에이전트는 무대 뒤에서 추론하며, 프롬프트 조립은 투명하게 추적됩니다.',
    callout: '현재 공개 문서는 외부 이해를 돕기 위한 제품 개념만을 설명합니다. 내부 설계 규격은 별도로 보존됩니다.',
    diagramHeading: '최소 개념도',
    diagram: `Narrative Timeline
  제어되어 커밋된 정문(正文)만을 보존
        ↕ 연관되나 뿌리를 공유하지 않음
Agent Session
  메시지, 추론, 도구 및 작업 기록 보존
        ↓ 이번 턴의 입력 구성
Prompt Build
  Source 선택 → 마운트 및 슬롯 할당 → Activation → Trace
        ↓ 컴파일된 메시지
Provider`,
    statusHeading: '현재 구축 상태',
    tableHeaders: ['영역', '현재 상태', '경계'],
    tableRows: [
      ['제품 포털', '기반 구축 완료', '정적 표시 위주, 실제 작업 영역과 직접 미연결'],
      ['공개 문서', '초기 개념 페이지', '독립 유지 관리, 내부 규격 비공개 원칙'],
      ['다운로드 & 변경로그', '후속 단계', '설치 파일은 GitHub Releases를 통해 배포'],
      ['엣지 배포 구성', '보류', '로컬 검증 완료 후 단계적 진행'],
    ],
  },
};

const sectionTexts = sectionTextsData[currentLocale] ?? sectionTextsData['en'];

const overviewHeadings = [
  { depth: 2, slug: 'intro', text: sectionTexts.introHeading },
  { depth: 2, slug: 'concept-map', text: sectionTexts.diagramHeading },
  { depth: 2, slug: 'status', text: sectionTexts.statusHeading },
];
---

<DocsLayout
  locale={currentLocale}
  frontmatter={{ title: meta.title, description: meta.description }}
  headings={overviewHeadings}
>
  <section class="docs-intro" data-motion-reveal>
    <h2 id="intro">{sectionTexts.introHeading}</h2>
    <p>{sectionTexts.introDesc}</p>
    <blockquote data-callout="boundary">{sectionTexts.callout}</blockquote>
  </section>

  <section class="docs-card-grid" data-motion-group>
    {cards.map((card) => (
      <a href={card.href} data-motion-reveal data-motion-feedback>
        <span>{card.tag}</span>
        <h3>{card.title}</h3>
        <p>{card.copy}</p>
        <ArrowRight class="card-arrow" size={17} stroke-width={1.8} />
      </a>
    ))}
  </section>

  <h2 id="concept-map">{sectionTexts.diagramHeading}</h2>
  <pre><code>{sectionTexts.diagram}</code></pre>

  <h2 id="status">{sectionTexts.statusHeading}</h2>
  <table>
    <thead>
      <tr>
        {sectionTexts.tableHeaders.map((header) => (<th>{header}</th>))}
      </tr>
    </thead>
    <tbody>
      {sectionTexts.tableRows.map((row) => (
        <tr>
          {row.map((cell) => (<td>{cell}</td>))}
        </tr>
      ))}
    </tbody>
  </table>
</DocsLayout>

<style>
  .docs-card-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 36px 0 58px;
  }
  .docs-card-grid a {
    position: relative;
    min-height: 190px;
    display: grid;
    align-content: start;
    border-radius: 18px;
    padding: 24px;
    background: var(--loom-site-surface);
    transition: background 160ms ease;
  }
  .docs-card-grid a:hover {
    background: var(--loom-site-surface-raised);
  }
  .docs-card-grid span {
    color: var(--loom-site-accent);
    font: 9px var(--loom-site-font-mono);
    letter-spacing: 0.14em;
  }
  .docs-card-grid h3 {
    margin: 28px 0 10px;
    color: var(--loom-site-text);
    font: 580 20px var(--loom-site-font-display);
  }
  .docs-card-grid p {
    margin: 0;
    color: var(--loom-site-text-muted);
    font-size: 12px;
    line-height: 1.7;
  }
  .docs-card-grid :global(.card-arrow) {
    position: absolute;
    right: 20px;
    bottom: 16px;
    color: var(--loom-site-text-subtle);
  }
  @media (max-width: 620px) {
    .docs-card-grid { grid-template-columns: 1fr; }
  }
</style>
