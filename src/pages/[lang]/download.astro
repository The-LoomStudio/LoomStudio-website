---
import PortalLayout from '../../layouts/PortalLayout.astro';
import DownloadConsole from '../../components/download/DownloadConsole';
import AnimatedDetails from '../../components/motion/AnimatedDetails.astro';
import NomSticker from '../../components/NomSticker.astro';
import { ArrowUpRight, ChevronDown } from '@lucide/astro';
import { type SiteLocale, pageMeta } from '../../lib/i18n';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'ja' } },
    { params: { lang: 'ko' } },
  ];
}

const { lang } = Astro.params;
const currentLocale = lang as SiteLocale;
const meta = pageMeta.download[currentLocale] ?? pageMeta.download['en'];

const tipText = currentLocale === 'ja' ? '初回起動には少し時間がかかります。ターミナルを開いたままお待ちください。' : currentLocale === 'ko' ? '첫 실행에는 시간이 조금 걸립니다. 터미널 창을 닫지 마세요.' : 'Initial startup takes a few moments. Keep your terminal open.';

const stepsData: Record<SiteLocale, {
  heading: string;
  more: string;
  steps: { index: string; title: string; desc: string; link?: string }[];
}> = {
  'en': {
    heading: 'Next Steps',
    more: 'More details',
    steps: [
      { index: '01 / Workbench', title: '127.0.0.1:18010', desc: '', link: 'http://127.0.0.1:18010' },
      { index: '02 / Models', title: 'API & Credentials', desc: 'Configure model providers, keys, and assign them to your presets.' },
      { index: '03 / Re-launch', title: 'npm start', desc: 'Run npm start in the LoomStudio folder anytime you play.' },
    ],
  },
  'ja': {
    heading: '次のステップ',
    more: '詳細',
    steps: [
      { index: '01 / ワークベンチ', title: '127.0.0.1:18010', desc: '', link: 'http://127.0.0.1:18010' },
      { index: '02 / モデル設定', title: 'API 設定と認証', desc: 'モデル Provider と API キーを設定し、プリセットに割り当てます。' },
      { index: '03 / 次回の起動', title: 'npm start', desc: '次回以降は LoomStudio フォルダで npm start を実行します。' },
    ],
  },
  'ko': {
    heading: '다음 단계',
    more: '자세히 보기',
    steps: [
      { index: '01 / 작업대', title: '127.0.0.1:18010', desc: '', link: 'http://127.0.0.1:18010' },
      { index: '02 / 모델 설정', title: 'API 및 인증 정보', desc: '모델 Provider와 키를 설정하고 프리셋에 연결하세요.' },
      { index: '03 / 다시 실행', title: 'npm start', desc: '다음 플레이 시 LoomStudio 폴더에서 npm start를 입력하세요.' },
    ],
  },
  'zh-CN': {
    heading: '后续步骤',
    more: '查看详情',
    steps: [
      { index: '01 / 工作台', title: '127.0.0.1:18010', desc: '', link: 'http://127.0.0.1:18010' },
      { index: '02 / 模型配置', title: 'API 与凭据', desc: '配置模型 Provider 与密钥，并将其分配给你的预设。' },
      { index: '03 / 再次启动', title: 'npm start', desc: '下次游玩时，在 LoomStudio 目录运行 npm start。' },
    ],
  },
};

const stepInfo = stepsData[currentLocale] ?? stepsData['en'];
---

<PortalLayout
  title={meta.title}
  description={meta.description}
  eyebrow={meta.eyebrow}
  marker={meta.marker}
  headline={meta.headline}
  intro={meta.intro}
  locale={currentLocale}
>
  <section class="portal-section portal-section--soft">
    <div class="container download-start" data-motion-group>
      <div class="download-start__intro" data-motion-reveal>
        <span class="portal-tag">Git / Source</span>
        <h2>{meta.headline}</h2>
        <p><strong>Git</strong> & <strong>Node.js 24.22.0+</strong></p>
        <div class="download-links">
          <a href="https://git-scm.com/downloads" target="_blank" rel="noreferrer">Git <ArrowUpRight size={15} /></a>
          <a href="https://nodejs.org/en/download" target="_blank" rel="noreferrer">Node.js <ArrowUpRight size={15} /></a>
        </div>
      </div>
      <div class="download-terminal">
        <DownloadConsole locale={currentLocale} client:load />
        <div class="download-tip"><NomSticker src="/images/nom/stickers/bust/tip.png" size="small" message={tipText} /></div>
      </div>
    </div>
  </section>
  <section class="portal-section">
    <div class="container">
      <div class="portal-section__heading"><div><small>START / PLAY</small><h2>{stepInfo.heading}</h2></div></div>
      <div class="download-steps" data-motion-group>
        {stepInfo.steps.map((s) => (
          <article data-motion-reveal>
            <span>{s.index}</span>
            <h3>{s.title}</h3>
            <AnimatedDetails class="download-step">
              <span slot="summary">{stepInfo.more}<ChevronDown size={14} aria-hidden="true" /></span>
              <p>
                {s.link ? <a href={s.link} target="_blank" rel="noreferrer">{s.link}</a> : s.desc}
              </p>
            </AnimatedDetails>
          </article>
        ))}
      </div>
    </div>
  </section>
</PortalLayout>


<style>
.download-start { display: grid; grid-template-columns: .8fr 1.2fr; gap: 48px; align-items: start; }
.download-terminal { min-width: 0; }
.download-tip { margin-top: 22px; }
.download-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
.download-steps article { min-width: 0; border-top: 1px solid var(--loom-site-border); padding-top: 24px; }
.download-step :global(summary) { cursor: pointer; min-height: 40px; display: flex; align-items: center; font-size: 12px; }
.download-step :global(summary) > span { display: flex; align-items: center; gap: 10px; }
@media (max-width: 760px) { .download-start, .download-steps { grid-template-columns: 1fr; } }
</style>
