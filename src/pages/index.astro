---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ProductPreview from '../components/ProductPreview.astro';
import IntroLoader from '../components/IntroLoader.astro';
import CardMarquee from '../components/card-showcase/CardMarquee';
import CardStack from '../components/card-showcase/CardStack';
import HeroBanner from '../components/HeroBanner';
import StoryParallaxWall from '../components/StoryParallaxWall.astro';

const features = [
  {
    index: '01',
    title: '故事，好好读',
    copy: '把确认的情节留在正文里，把推演草稿交给后台。沿着角色的脚步，一页一页读下去。',
  },
  {
    index: '02',
    title: '幕后，有帮手',
    copy: 'Agent 在自己的工作区整理线索、调用工具。想知道它忙了什么？打开面板就能看看。',
  },
  {
    index: '03',
    title: '灵感，有来处',
    copy: '这次对话用到了哪些设定，又带上了哪段记忆？展开提示词构建过程，把故事的来龙去脉看清楚。',
  },
];
---

<BaseLayout title="Loom Studio" description="专为长篇角色扮演与互动叙事打造的桌面工具：分离剧情正文、推演过程与提示词构建，让每一次选择都能延展成清晰的世界线">
  <IntroLoader />
  <SiteHeader />

  <main>
    <section class="hero" id="top">
      <nav class="hero__sections" aria-label="发布页章节">
        <span>SECTIONS</span>
        <a href="#story">01 叙事</a>
        <a href="#system">02 系统</a>
        <a href="#architecture">03 架构</a>
      </nav>
      <HeroBanner client:load />
      <a class="hero__scroll" href="#story"><span>向下滚动探索</span><i></i></a>
    </section>

    <div class="home-content">
    <section class="brand-banner" aria-label="Loom Studio 品牌 Banner">
      <CardStack client:visible />
      <div class="brand-banner__sticker">
        <img src="/brand/banner.png" alt="Loom Studio" loading="lazy" decoding="async" />
      </div>
      <p>编织世界，交织故事。<br />把下一段旅程留给你自己。</p>
    </section>

    <section class="card-banner card-banner--top" aria-labelledby="card-banner-title">
      <div class="container card-banner__heading">
        <p class="eyebrow">A gallery of possibilities</p>
        <h2 id="card-banner-title">每一张卡面<br />都可以是一个新的角色</h2>
      </div>
      <CardMarquee client:visible />
    </section>

    <section class="manifesto" id="story">
      <div class="container manifesto__grid">
        <div class="manifesto__sticky" data-chapter="01 / NARRATIVE">
          <p class="eyebrow">A home for your stories</p>
          <h2>故事还长<br />我们慢慢讲</h2>
          <p>
            一封来信、一位老朋友，或是一条没走过的小路。<br />
            把它们放进你的世界，让正文、设定和幕后推演各有自己的位置，陪故事走得更远。
          </p>
        </div>
        <div class="manifesto__features">
          {features.map((feature) => (
            <article>
              <span>{feature.index}</span>
              <h3>{feature.title}</h3>
              <p>{feature.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="product" id="system">
      <div class="container">
        <div class="section-heading" data-chapter="02 / SYSTEM">
          <div>
            <p class="eyebrow">Inside the studio</p>
            <h2>你的小小工作室<br />装得下大大的世界</h2>
          </div>
          <p>
            角色的秘密、世界的规则，还有刚刚发生的冒险，都在这里。<br />
            先试试下面这段小故事，再打开工作区，看看它是怎样被编织出来的。
          </p>
        </div>
        <div class="product__stage">
          <ProductPreview />
        </div>
        <div class="product__legend">
          <div><span>01</span><b>故事时间线</b><p>沿着正文，找回每一次选择</p></div>
          <div><span>02</span><b>Agent 工作区</b><p>看看幕后帮手的思路和工具记录</p></div>
          <div><span>03</span><b>提示词构建</b><p>看清哪些设定参与了这一轮对话</p></div>
        </div>
      </div>
    </section>

    <section class="architecture" id="architecture">
      <div class="container architecture__inner" data-chapter="03 / ARCHITECTURE">
        <p class="eyebrow">A little look backstage</p>
        <h2>好故事的背后<br />也有小小的分工</h2>
        <div class="architecture__flow">
          <div><small>STORY</small><b>剧情正文</b><span>呈现故事与分支</span></div>
          <i>↔</i>
          <div><small>WORK</small><b>推演会话</b><span>负责逻辑推导与工具</span></div>
          <i>→</i>
          <div><small>CONTEXT</small><b>提示词构建</b><span>负责资源装配与激活</span></div>
          <i>→</i>
          <div><small>MODEL</small><b>模型接入</b><span>只接收编译结果</span></div>
        </div>
        <p class="architecture__note">
          正文讲故事，Agent 理线索，构建器把需要的设定送给模型。<br />
          每一步都有迹可循，你可以安心游玩，也可以随时掀开幕布，动手改一改。
        </p>
      </div>
    </section>

    <StoryParallaxWall />
    </div>

    <section class="adventure">
      <HeroBanner client:visible variant="bottom" />
    </section>
  </main>

  <SiteFooter easterEgg />


  <script>
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const parallaxItems = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
    let frame = 0;

    const updateParallax = () => {
      frame = 0;
      if (reduceMotion.matches) return;
      const viewport = window.innerHeight;
      for (const item of parallaxItems) {
        const rect = item.getBoundingClientRect();
        if (rect.bottom < -200 || rect.top > viewport + 200) continue;
        const speed = Number(item.dataset.parallax ?? 0);
        const centerOffset = rect.top + rect.height / 2 - viewport / 2;
        item.style.setProperty('--parallax-y', String(centerOffset * speed) + 'px');
      }
    };

    const requestUpdate = () => {
      if (!frame) frame = window.requestAnimationFrame(updateParallax);
    };

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate);
    updateParallax();

    const finePointer = window.matchMedia('(pointer: fine)');
    let scrollTarget = window.scrollY;
    let scrollFrame = 0;
    let lastScrollTime = 0;

    const stopWheelScroll = () => {
      window.cancelAnimationFrame(scrollFrame);
      scrollFrame = 0;
      scrollTarget = window.scrollY;
    };

    const animateWheelScroll = (time: number) => {
      scrollTarget = Math.max(0, Math.min(scrollTarget, document.documentElement.scrollHeight - window.innerHeight));
      const current = window.scrollY;
      const distance = scrollTarget - current;
      if (Math.abs(distance) < 0.5) {
        window.scrollTo({ top: scrollTarget, behavior: 'instant' });
        scrollFrame = 0;
        return;
      }
      const amount = 1 - Math.exp(-(time - lastScrollTime) / 100);
      lastScrollTime = time;
      window.scrollTo({ top: current + distance * amount, behavior: 'instant' });
      scrollFrame = window.requestAnimationFrame(animateWheelScroll);
    };

    const onWheel = (event: WheelEvent) => {
      if (
        reduceMotion.matches || !finePointer.matches || event.defaultPrevented || !event.cancelable ||
        event.ctrlKey || event.metaKey || event.shiftKey || !event.deltaY ||
        Math.abs(event.deltaY) < Math.abs(event.deltaX) ||
        document.documentElement.hasAttribute('data-menu-open') || document.querySelector('dialog[open]')
      ) {
        stopWheelScroll();
        return;
      }
      // Let demo panes, editors and other nested scroll areas retain native input.
      for (const element of event.composedPath()) {
        if (element === document.body || element === document.documentElement) break;
        if (!(element instanceof HTMLElement)) continue;
        if (
          element.matches('input, textarea, select, [contenteditable]:not([contenteditable="false"])') ||
          (/(auto|scroll)/.test(getComputedStyle(element).overflowY) && element.scrollHeight > element.clientHeight)
        ) {
          stopWheelScroll();
          return;
        }
      }
      event.preventDefault();
      if (!scrollFrame) scrollTarget = window.scrollY;
      const unit = event.deltaMode === WheelEvent.DOM_DELTA_LINE ? 16 : event.deltaMode === WheelEvent.DOM_DELTA_PAGE ? window.innerHeight : 1;
      const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
      scrollTarget = Math.max(0, Math.min(maxScroll, scrollTarget + event.deltaY * unit * 0.45));
      if (!scrollFrame) {
        lastScrollTime = performance.now();
        scrollFrame = window.requestAnimationFrame(animateWheelScroll);
      }
    };

    window.addEventListener('wheel', onWheel, { passive: false });
    window.addEventListener('pointerdown', stopWheelScroll, { passive: true, capture: true });
    window.addEventListener('touchstart', stopWheelScroll, { passive: true, capture: true });
    window.addEventListener('keydown', stopWheelScroll, { capture: true });
    window.addEventListener('resize', stopWheelScroll);
    window.addEventListener('pagehide', stopWheelScroll);
    reduceMotion.addEventListener('change', stopWheelScroll);
    finePointer.addEventListener('change', stopWheelScroll);
  </script>
</BaseLayout>

<style>
  :global(body:has(.hero)) {
    --loom-site-font-sans: "Nunito", "ZCOOL KuaiLe", "PingFang SC", sans-serif;
    --loom-site-font-display: "Fredoka", "ZCOOL KuaiLe", sans-serif;
  }
  .hero {
    position: relative;
    z-index: 1;
    height: 100svh;
    min-height: 100svh;
    display: grid;
    align-items: center;
    overflow: clip;
    padding: 0;
    background: transparent;
  }
  .home-content {
    position: relative;
    z-index: 2;
    margin-bottom: 100svh;
    background: var(--loom-site-bg);
    box-shadow: 0 -24px 54px rgb(8 12 16 / .24);
  }
  .home-content::before {
    position: absolute;
    top: -240px;
    right: 0;
    left: 0;
    height: 240px;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgb(var(--loom-site-bg-channels) / .08) 22%,
      rgb(var(--loom-site-bg-channels) / .34) 52%,
      rgb(var(--loom-site-bg-channels) / .78) 78%,
      var(--loom-site-bg) 100%
    );
    content: '';
    pointer-events: none;
  }
  .hero__sky-fade {
    position: absolute;
    z-index: 0;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(var(--loom-site-bg-channels) / 0) 0%,
      rgb(var(--loom-site-bg-channels) / 0.08) 20%,
      rgb(var(--loom-site-bg-channels) / 0.32) 42%,
      rgb(var(--loom-site-bg-channels) / 0.72) 68%,
      rgb(var(--loom-site-bg-channels) / 0.96) 86%,
      rgb(var(--loom-site-bg-channels) / 1) 100%
    );
    pointer-events: none;
  }
  .hero__sections {
    position: absolute;
    z-index: 2;
    top: calc(var(--loom-site-header-height) + 24px);
    left: 50%;
    width: min(calc(100% - 40px), var(--loom-site-max-width));
    display: flex;
    align-items: center;
    gap: 22px;
    color: var(--loom-site-text-subtle);
    font: 10px var(--loom-site-font-mono);
    letter-spacing: 0.14em;
    transform: translateX(-50%);
  }
  .hero__sections span { opacity: 0.62; letter-spacing: 0.2em; }
  .hero__sections a { transition: color 160ms ease; }
  .hero__sections a:hover { color: var(--loom-site-text); }
  .hero__content {
    position: absolute;
    top: 50svh;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 0;
    text-align: center;
  }
  .hero__copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 740px;
    width: 100%;
    background: transparent;
  }
  .hero__heading-row {
    position: absolute;
    left: calc(50% + clamp(120px, 16vw, 180px) + 24px);
    top: 50%;
    transform: translateY(-50%);
    display: block;
    gap: 20px;
  }
  .hero__chapter-tag {
    color: var(--loom-site-text-subtle);
    font: 8px var(--loom-site-font-mono);
    letter-spacing: 0.2em;
    writing-mode: vertical-rl;
    opacity: 0.7;
    margin-top: 6px;
    user-select: none;
    pointer-events: none;
  }
  .hero h1 {
    margin: 0;
    font: 400 clamp(18px, 2vw, 26px)/1.6 var(--loom-site-font-display);
    letter-spacing: 0.18em;
    writing-mode: vertical-rl;
    white-space: nowrap;
    text-wrap: balance;
    text-shadow: none;
  }
  .hero h1 em {
    display: block;
    color: var(--loom-site-accent);
    font-style: normal;
  }
  .hero__lead {
    position: absolute;
    top: 100%;
    width: min(610px, 90vw);
    max-width: 610px;
    margin: 24px auto 0;
    color: var(--loom-site-text-muted);
    font-size: 17px;
    line-height: 1.85;
    text-wrap: pretty;
  }
  .hero__actions {
    position: absolute;
    top: calc(100% + 124px);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 0;
  }
  .hero__banner {
    margin-top: 0;
    margin-bottom: 0;
    display: block;
    max-width: 100%;
  }
  .hero__banner img {
    display: block;
    width: clamp(240px, 32vw, 360px);
    max-width: 100%;
    height: auto;
    filter: drop-shadow(0 14px 32px rgba(0, 0, 0, 0.1));
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1), filter 300ms ease;
  }
  .hero__banner img:hover {
    transform: scale(1.02);
    filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.18));
  }
  .hero__scroll {
    position: absolute;
    z-index: 1;
    bottom: 28px;
    left: 50%;
    display: grid;
    justify-items: center;
    gap: 10px;
    color: var(--loom-site-text-subtle);
    font: 8px var(--loom-site-font-mono);
    letter-spacing: 0.16em;
    transform: translateX(-50%);
  }
  .hero__scroll i { width: 1px; height: 38px; background: var(--loom-site-text-subtle); }
  .brand-banner {
    position: relative;
    display: grid;
    min-height: clamp(520px, 42vw, 600px);
    place-items: center;
    gap: 18px;
    padding: 42px 20px 48px;
    overflow: clip;
    background: var(--loom-site-bg);
  }
  .brand-banner :global(.card-showcase--stack) {
    position: absolute;
    inset: 0;
    height: 100%;
    pointer-events: none;
  }
  .brand-banner :global(.card-showcase__card) { pointer-events: auto; }
  .banner-footer { position: absolute; z-index: 4; inset: auto 0 0; }
  .adventure :global(.hero-banner__controls) { bottom: 12%; }
  @media (max-width: 760px) {
    .brand-banner { min-height: 500px; }
    .brand-banner :global(.card-showcase__stack) {
      width: 100%;
      transform: none;
    }
    .brand-banner :global(.card-showcase--stack .card-showcase__card) {
      width: clamp(150px, 42vw, 205px);
      --card-scale: .88 !important;
      --card-hover-scale: .96 !important;
    }
    .brand-banner :global(.card-showcase--stack .card-showcase__card:nth-child(1)) {
      --card-x: clamp(-130px, -31vw, -92px) !important;
      --card-y: 125px !important;
    }
    .brand-banner :global(.card-showcase--stack .card-showcase__card:nth-child(2)) {
      --card-x: clamp(-96px, -23vw, -70px) !important;
      --card-y: -100px !important;
    }
    .brand-banner :global(.card-showcase--stack .card-showcase__card:nth-child(3)) {
      --card-x: clamp(70px, 23vw, 96px) !important;
      --card-y: -100px !important;
    }
    .brand-banner :global(.card-showcase--stack .card-showcase__card:nth-child(4)) {
      --card-x: clamp(92px, 31vw, 130px) !important;
      --card-y: 125px !important;
    }
    .brand-banner__sticker { width: 160px; }
    .adventure :global(.hero-banner__controls) { bottom: 16%; }
  }
  .brand-banner__sticker {
    position: relative;
    z-index: 20;
    width: min(240px, 62vw);
    filter: drop-shadow(0 14px 22px rgb(8 12 16 / .24));
  }
  .brand-banner__sticker img {
    display: block;
    width: 100%;
    height: auto;
  }
  .brand-banner > p {
    position: relative;
    z-index: 20;
    margin: 0;
    color: var(--loom-site-text-muted);
    font: 14px/1.8 var(--loom-site-font-display);
    text-align: center;
  }
  .manifesto {
    position: relative;
    min-height: auto;
    overflow: clip;
    padding: 160px 0;
    background: var(--loom-site-bg);
  }
  .card-banner {
    position: relative;
    overflow: hidden;
    padding: 110px 0 92px;
    background: var(--loom-site-bg);
  }
  .card-banner__heading {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    margin-bottom: 48px;
    text-align: center;
  }
  .card-banner__heading h2 {
    margin: 0;
    font: 540 clamp(38px, 5vw, 64px)/1.18 var(--loom-site-font-display);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .manifesto__grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr; gap: 72px; text-align: center; }
  .manifesto__sticky {
    position: relative;
    height: fit-content;
    border-radius: 24px;
    padding: 32px;
    background: transparent;
  }
  .section-heading,
  .adventure__panel { position: relative; }
  [data-chapter]::after {
    content: attr(data-chapter);
    position: absolute;
    top: 24px;
    right: 20px;
    color: var(--loom-site-text-subtle);
    font: 8px var(--loom-site-font-mono);
    letter-spacing: 0.2em;
    writing-mode: vertical-rl;
  }
  .manifesto h2, .section-heading h2, .architecture h2, .adventure h2 {
    margin: 0;
    font: 540 clamp(42px, 5.6vw, 70px)/1.16 var(--loom-site-font-display);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .manifesto__sticky > p:last-child {
    max-width: 500px;
    margin: 28px auto 0;
    color: var(--loom-site-text-muted);
    font-size: 16px;
    line-height: 1.9;
  }
  .manifesto__features { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .manifesto__features article {
    min-height: 0;
    border-radius: 24px;
    padding: 32px;
    background: transparent;
  }
  .manifesto__features span { color: var(--loom-site-accent); font: 10px var(--loom-site-font-mono); letter-spacing: 0.14em; }
  .manifesto__features h3 { margin: 46px 0 18px; font: 560 30px/1.32 var(--loom-site-font-display); letter-spacing: 0.01em; }
  .manifesto__features p {
    max-width: 470px;
    margin: 0;
    color: var(--loom-site-text-muted);
    font-size: 15px;
    line-height: 1.85;
  }
  .product { position: relative; z-index: 2; padding: 150px 0 170px; background: transparent; }
  .product::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, var(--loom-site-bg) 0%, transparent 18%, transparent 82%, var(--loom-site-bg) 100%);
  }
  .product > .container { position: relative; z-index: 1; }
  .section-heading {
    display: grid;
    grid-template-columns: 1fr;
    justify-items: center;
    text-align: center;
    gap: 28px;
    margin-bottom: 78px;
    border-radius: 24px;
    padding: 32px;
    background: transparent;
  }
  .section-heading > p {
    max-width: 640px;
    margin: 0 0 8px;
    color: var(--loom-site-text-muted);
    font-size: 15px;
    line-height: 1.9;
  }
  .product__stage {
    transform: translate3d(0, var(--parallax-y, 0), 0);
    will-change: transform;
  }
  .product__legend {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 46px;
    background: transparent;
  }
  .product__legend > div {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px 14px;
    border-radius: 16px;
    padding: 30px;
    background: transparent;
  }
  .product__legend span { color: var(--loom-site-accent); font: 10px var(--loom-site-font-mono); }
  .product__legend b { font-size: 13px; }
  .product__legend p {
    grid-column: 2;
    margin: 0;
    color: var(--loom-site-text-subtle);
    font-size: 12px;
    line-height: 1.65;
  }
  .architecture {
    position: relative;
    min-height: 850px;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: var(--loom-site-bg);
  }
  .architecture::before {
    display: none;
  }
  .architecture__inner {
    position: relative;
    z-index: 1;
    border-radius: 30px;
    padding: 56px 40px;
    background: transparent;
    text-align: center;
  }
  .architecture h2 { max-width: 850px; margin-inline: auto; }
  .architecture__flow {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    align-items: center;
    gap: 14px;
    margin-top: 78px;
  }
  .architecture__flow > div {
    min-height: 145px;
    display: grid;
    align-content: center;
    gap: 8px;
    border-radius: 18px;
    padding: 18px;
    background: transparent;
  }
