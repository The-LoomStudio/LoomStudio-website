---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ProductPreview from '../components/ProductPreview.astro';
import SkyBackdrop from '../components/SkyBackdrop.astro';
import IntroLoader from '../components/IntroLoader.astro';
import { ArrowRight } from '@lucide/astro';

const features = [
  {
    index: '01',
    title: 'Narrative 不是聊天记录',
    copy: '受控提交的剧情正文进入独立 Narrative Timeline。长篇章节、世界线与回退不再被一次次 Provider 对话淹没。',
  },
  {
    index: '02',
    title: 'Agent 有自己的工作空间',
    copy: 'Agent Session 保存推演、工具调用与工作过程；它可以服务于剧情，却不与正文共根，也不会假装每一步思考都是故事。',
  },
  {
    index: '03',
    title: '看见 Prompt 如何成为 Prompt',
    copy: '资源、Zone、Slot、Activation 与 Trace 组成可检查的构建路径。复杂上下文不必继续藏在一个巨大文本框里。',
  },
];
---

<BaseLayout title="Loom Studio" description="面向深度长篇 AI 互动叙事的桌面工作台：分离 Narrative、Agent Session 与 Prompt Build，让故事拥有真正的世界线。">
  <IntroLoader />
  <SiteHeader />
  <SkyBackdrop />

  <main>
    <section class="hero" id="top" data-sky-intro>
      <div class="hero__sky-fade" aria-hidden="true"></div>
      <nav class="hero__sections" aria-label="发布页章节">
        <span>SECTIONS</span>
        <a href="#story">01 叙事</a>
        <a href="#system">02 系统</a>
        <a href="#architecture">03 架构</a>
      </nav>
      <div class="container hero__content">
        <div class="hero__copy">
          <div class="hero__copy-main">
            <p class="eyebrow">Deep-form AI role-playing studio / Episode 00</p>
            <h1><span>让故事长成一条</span><em>真正的世界线</em></h1>
            <p class="hero__lead">Loom Studio 是为深度长篇 AI 互动叙事打造的桌面工作台。它把剧情正文、Agent 工作过程与 Prompt 构建拆开，让每一次选择都可以继续、分支、回望。</p>
            <div class="hero__actions">
              <a class="button button--primary" href="/docs">开始阅读文档 <ArrowRight size={16} stroke-width={1.8} /></a>
              <a class="button" href="#story">探索 Loom Studio</a>
            </div>
            <div class="hero__banner">
              <img src="/brand/banner.png" alt="Loom Studio" width="240" height="180" loading="eager" decoding="async" />
            </div>
            <div class="hero__signal"><i></i><span>FOUNDATION BUILD</span><b>Local-first · Static website</b></div>
          </div>
          <p class="hero__vertical" aria-hidden="true"><span>让故事长成世界线</span><small>WORLDLINE / 00</small></p>
        </div>
      </div>
      <a class="hero__scroll" href="#story"><span>SCROLL TO DESCEND</span><i></i></a>
    </section>

    <section class="manifesto" id="story">
      <div class="container manifesto__grid">
        <div class="manifesto__sticky" data-chapter="01 / NARRATIVE">
          <p class="eyebrow">A story is not a transcript</p>
          <h2>长篇互动叙事<br />需要比聊天框更深的结构</h2>
          <p>一次对话可以结束，但一个世界不会。Loom Studio 从第一天就把“故事写了什么”和“Agent 做了什么”视为两条互相关联、却彼此独立的时间线。</p>
        </div>
        <div class="manifesto__features">
          {features.map((feature) => (
            <article>
              <span>{feature.index}</span>
              <h3>{feature.title}</h3>
              <p>{feature.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="product" id="system">
      <div class="container">
        <div class="section-heading" data-chapter="02 / SYSTEM">
          <div>
            <p class="eyebrow">Inside the loom</p>
            <h2>文学的表面<br />工程的骨架</h2>
          </div>
          <p>桌面级高信息密度界面服务于长时间创作。Narrative、角色、Prompt Resource 与 Build Trace 在一个工作空间里彼此靠近，但保持清晰边界。</p>
        </div>
        <div class="product__stage" data-parallax="0.04">
          <ProductPreview />
        </div>
        <div class="product__legend">
          <div><span>01</span><b>Narrative Timeline</b><p>只保存经过受控提交的故事正文与世界线。</p></div>
          <div><span>02</span><b>Agent Session</b><p>容纳推演、工具、工作历史与独立分支。</p></div>
          <div><span>03</span><b>Prompt Build</b><p>以 Structure、Source、Activation 与 Trace 解释每轮上下文。</p></div>
        </div>
      </div>
    </section>

    <section class="architecture" id="architecture">
      <div class="container architecture__inner" data-chapter="03 / ARCHITECTURE">
        <p class="eyebrow">Built for depth, not spectacle</p>
        <h2>故事向前走<br />系统在背后留下证据</h2>
        <div class="architecture__flow">
          <div><small>STORY</small><b>Narrative Timeline</b><span>正文 · 分支 · 状态</span></div>
          <i>↔</i>
          <div><small>WORK</small><b>Agent Session</b><span>步骤 · 工具 · Changeset</span></div>
          <i>→</i>
          <div><small>CONTEXT</small><b>Prompt Build</b><span>资源 · 激活 · Trace</span></div>
          <i>→</i>
          <div><small>MODEL</small><b>Provider</b><span>只接收编译结果</span></div>
        </div>
        <p class="architecture__note">Kernel 不理解小说，Provider 不决定正文，Prompt Builder 不推进 Agent。每层只做自己应该做的事。</p>
      </div>
    </section>

    <section class="adventure" data-sky-final>
      <div class="adventure__fade" aria-hidden="true"></div>
      <div class="container adventure__content">
        <div class="adventure__panel" data-chapter="04 / ADVENTURE">
          <p class="eyebrow">Beyond the last page</p>
          <h2>写到文本框之外</h2>
          <p>让技术退到足够深的地方，让角色、世界与选择重新站到故事中央。最后留下的，不是一串对话，而是一段真正走过的旅程。</p>
          <a class="button button--primary" href="/docs">进入公开文档 <ArrowRight size={16} stroke-width={1.8} /></a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter easterEgg />

  <script>
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const parallaxItems = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
    let frame = 0;

    const updateParallax = () => {
      frame = 0;
      if (reduceMotion.matches) return;
      const viewport = window.innerHeight;
      for (const item of parallaxItems) {
        const rect = item.getBoundingClientRect();
        if (rect.bottom < -200 || rect.top > viewport + 200) continue;
        const speed = Number(item.dataset.parallax ?? 0);
        const centerOffset = rect.top + rect.height / 2 - viewport / 2;
        item.style.setProperty('--parallax-y', String(centerOffset * speed) + 'px');
      }
    };

    const requestUpdate = () => {
      if (!frame) frame = window.requestAnimationFrame(updateParallax);
    };

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate);
    updateParallax();
  </script>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: max(780px, 100svh);
    display: grid;
    align-items: center;
    overflow: hidden;
    padding-top: var(--loom-site-header-height);
    background: transparent;
  }
  .hero__sky-fade {
    position: absolute;
    z-index: 0;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(var(--loom-site-bg-channels) / 0) 0%,
      rgb(var(--loom-site-bg-channels) / 0.08) 20%,
      rgb(var(--loom-site-bg-channels) / 0.32) 42%,
      rgb(var(--loom-site-bg-channels) / 0.72) 68%,
      rgb(var(--loom-site-bg-channels) / 0.96) 86%,
      rgb(var(--loom-site-bg-channels) / 1) 100%
    );
    pointer-events: none;
  }
  .hero__sections {
    position: absolute;
    z-index: 2;
    top: calc(var(--loom-site-header-height) + 22px);
    left: 50%;
    width: min(calc(100% - 40px), var(--loom-site-max-width));
    display: flex;
    align-items: center;
    gap: 22px;
    color: var(--loom-site-text-subtle);
    font: 9px var(--loom-site-font-mono);
    letter-spacing: 0.14em;
    transform: translateX(-50%);
  }
  .hero__sections span { opacity: 0.62; letter-spacing: 0.2em; }
  .hero__sections a { transition: color 160ms ease; }
  .hero__sections a:hover { color: var(--loom-site-text); }
  .hero__content { display: flex; align-items: center; }
  .hero__copy {
    position: relative;
    z-index: 1;
    width: min(790px, 100%);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 34px;
    border-radius: 30px;
    padding: 42px;
    background: transparent;
  }
  .hero__banner {
    margin-top: 36px;
    margin-bottom: 24px;
    display: inline-block;
  }
  .hero__banner img {
    display: block;
    width: clamp(210px, 25vw, 270px);
    height: auto;
    filter: drop-shadow(0 14px 32px rgba(0, 0, 0, 0.1));
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1), filter 300ms ease;
  }
  .hero__banner img:hover {
    transform: translateY(-2px) scale(1.02);
    filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.18));
  }
  .hero h1 {
    margin: 0;
    font: 560 clamp(50px, 5.45vw, 70px)/1.08 var(--loom-site-font-display);
    letter-spacing: -0.038em;
    text-wrap: balance;
    text-shadow: none;
  }
  .hero h1 em {
    display: block;
    color: var(--loom-site-accent);
    font-style: normal;
  }
  .hero__lead {
    max-width: 610px;
    margin: 30px 0 0;
    color: var(--loom-site-text-muted);
    font-size: 17px;
    line-height: 1.85;
    text-wrap: pretty;
  }
  .hero__vertical {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin: 0;
    padding-left: 2px;
    color: var(--loom-site-text-muted);
    writing-mode: vertical-rl;
  }
  .hero__vertical span {
    font: 440 13px/1.8 var(--loom-site-font-display);
    letter-spacing: 0.28em;
  }
  .hero__vertical small {
    color: var(--loom-site-text-subtle);
    font: 8px var(--loom-site-font-mono);
    letter-spacing: 0.18em;
  }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }
  .hero__signal {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 42px;
    color: var(--loom-site-text-subtle);
    font: 9px var(--loom-site-font-mono);
    letter-spacing: 0.12em;
  }
  .hero__signal i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--loom-site-success);
    box-shadow: none;
  }
  .hero__signal b {
    border-left: 1px solid var(--loom-site-border);
    margin-left: 5px;
    padding-left: 14px;
    color: var(--loom-site-text-subtle);
    font-weight: 500;
    letter-spacing: 0;
  }
  .hero__scroll {
    position: absolute;
    z-index: 1;
    bottom: 28px;
    left: 50%;
    display: grid;
    justify-items: center;
    gap: 10px;
    color: var(--loom-site-text-subtle);
    font: 8px var(--loom-site-font-mono);
    letter-spacing: 0.16em;
    transform: translateX(-50%);
  }
  .hero__scroll i { width: 1px; height: 38px; background: var(--loom-site-text-subtle); }
  .manifesto {
    position: relative;
    min-height: 1550px;
    overflow: clip;
    padding: 160px 0;
    background: var(--loom-site-bg);
  }
  .manifesto__grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 12vw; }
  .manifesto__sticky {
    position: sticky;
    top: 150px;
    height: fit-content;
    border-radius: 24px;
    padding: 32px;
    background: transparent;
  }
  .section-heading,
  .adventure__panel { position: relative; }
  [data-chapter]::after {
    content: attr(data-chapter);
    position: absolute;
    top: 24px;
    right: 20px;
    color: var(--loom-site-text-subtle);
    font: 8px var(--loom-site-font-mono);
    letter-spacing: 0.2em;
    writing-mode: vertical-rl;
  }
  .manifesto h2, .section-heading h2, .architecture h2, .adventure h2 {
    margin: 0;
    font: 540 clamp(42px, 5.6vw, 70px)/1.16 var(--loom-site-font-display);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .manifesto__sticky > p:last-child {
    max-width: 500px;
    margin: 28px 0 0;
    color: var(--loom-site-text-muted);
    font-size: 16px;
    line-height: 1.9;
  }
  .manifesto__features { display: grid; gap: 160px; padding-top: 180px; }
  .manifesto__features article {
    min-height: 300px;
    border-radius: 24px;
    padding: 32px;
    background: transparent;
  }
  .manifesto__features span { color: var(--loom-site-accent); font: 10px var(--loom-site-font-mono); letter-spacing: 0.14em; }
  .manifesto__features h3 { margin: 46px 0 18px; font: 560 30px/1.32 var(--loom-site-font-display); letter-spacing: 0.01em; }
  .manifesto__features p {
    max-width: 470px;
    margin: 0;
    color: var(--loom-site-text-muted);
    font-size: 15px;
    line-height: 1.85;
  }
  .product { position: relative; z-index: 2; padding: 150px 0 170px; background: var(--loom-site-bg); }
  .product > .container { position: relative; z-index: 1; }
  .section-heading {
    display: grid;
    grid-template-columns: 1.1fr 0.65fr;
    align-items: end;
    gap: 80px;
    margin-bottom: 78px;
    border-radius: 24px;
    padding: 32px;
    background: transparent;
  }
  .section-heading > p {
    margin: 0 0 8px;
    color: var(--loom-site-text-muted);
    font-size: 15px;
    line-height: 1.9;
  }
  .product__stage {
    transform: translate3d(0, var(--parallax-y, 0), 0);
    will-change: transform;
  }
  .product__legend {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 46px;
    background: transparent;
  }
  .product__legend > div {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px 14px;
    border-radius: 16px;
    padding: 30px;
    background: transparent;
  }
  .product__legend span { color: var(--loom-site-accent); font: 10px var(--loom-site-font-mono); }
  .product__legend b { font-size: 13px; }
  .product__legend p {
    grid-column: 2;
    margin: 0;
    color: var(--loom-site-text-subtle);
    font-size: 12px;
    line-height: 1.65;
  }
  .architecture {
    position: relative;
    min-height: 850px;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: var(--loom-site-bg);
  }
  .architecture::before {
    display: none;
  }
  .architecture__inner {
    position: relative;
    z-index: 1;
    border-radius: 30px;
    padding: 56px 40px;
    background: transparent;
    text-align: center;
  }
  .architecture h2 { max-width: 850px; margin-inline: auto; }
  .architecture__flow {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    align-items: center;
    gap: 14px;
    margin-top: 78px;
  }
  .architecture__flow > div {
    min-height: 145px;
    display: grid;
    align-content: center;
    gap: 8px;
    border-radius: 18px;
    padding: 18px;
    background: transparent;
  }
  .architecture__flow small { color: var(--loom-site-accent); font: 9px var(--loom-site-font-mono); letter-spacing: 0.14em; }
  .architecture__flow b { font: 600 16px var(--loom-site-font-display); }
  .architecture__flow span { color: var(--loom-site-text-subtle); font-size: 10px; }
  .architecture__flow > i { color: var(--loom-site-text-subtle); font-style: normal; }
  .architecture__note {
    max-width: 680px;
    margin: 44px auto 0;
    color: var(--loom-site-text-muted);
    font-size: 14px;
    line-height: 1.8;
  }
  .adventure {
    position: relative;
    min-height: 1000px;
    display: grid;
    align-items: end;
    overflow: hidden;
    color: var(--loom-site-text);
    background: transparent;
    transition: color 320ms ease;
  }
  .adventure[data-sky-text='dark'] {
    --loom-site-text: #26343d;
    --loom-site-text-muted: #3d4c55;
    --loom-site-text-subtle: #53636c;
    --loom-site-accent: #344f5c;
  }
  .adventure__fade {
    position: absolute;
    z-index: 1;
    top: -1px;
    left: 0;
    width: 100%;
    height: clamp(380px, 46vw, 720px);
    background: linear-gradient(
      180deg,
      rgb(var(--loom-site-bg-channels) / 1) 0%,
      rgb(var(--loom-site-bg-channels) / 0.96) 14%,
      rgb(var(--loom-site-bg-channels) / 0.78) 36%,
      rgb(var(--loom-site-bg-channels) / 0.5) 58%,
      rgb(var(--loom-site-bg-channels) / 0.22) 78%,
      rgb(var(--loom-site-bg-channels) / 0) 100%
    );
    pointer-events: none;
  }
  .adventure__content { position: relative; z-index: 2; padding-bottom: 120px; }
  .adventure__panel {
    max-width: 650px;
    border-radius: 30px;
    padding: 42px;
    background: transparent;
  }
  .adventure__panel h2 {
    font-size: clamp(52px, 6vw, 76px);
  }
  .adventure__panel > p:not(.eyebrow) {
    max-width: 560px;
    margin: 28px 0 34px;
    color: var(--loom-site-text-muted);
    font: 17px/1.9 var(--loom-site-font-display);
    text-shadow: none;
  }
  @media (max-width: 900px) {
    .manifesto { min-height: auto; }
    .manifesto__grid, .section-heading { grid-template-columns: 1fr; gap: 54px; }
    .manifesto__sticky { position: static; }
    .manifesto__features { gap: 100px; padding-top: 40px; }
    .product__legend { grid-template-columns: 1fr; }
    .architecture__flow { grid-template-columns: 1fr; }
    .architecture__flow > i { transform: rotate(90deg); }
  }
  @media (max-width: 680px) {
    .hero { min-height: 900px; }
    .hero__sections { width: calc(100% - 28px); gap: 12px; font-size: 8px; letter-spacing: 0.08em; }
    .hero__sections span { display: none; }
    .hero__copy { max-width: none; grid-template-columns: 1fr; padding: 28px; }
    .hero__vertical { display: none; }
    .hero h1 { font-size: clamp(44px, 13.5vw, 62px); }
    .hero__lead { font-size: 15px; }
    .hero__signal b { display: none; }
    .manifesto, .product { padding-block: 110px; }
    .manifesto h2, .section-heading h2, .architecture h2 { font-size: 42px; }
    .manifesto__features article { min-height: auto; }
    .product__legend > div { padding: 24px 12px; }
    .architecture { padding: 110px 0; }
    .adventure { min-height: 820px; }
    .adventure__content { padding-bottom: 80px; }
    .adventure__panel { padding: 28px; }
    .adventure__panel h2,
    .adventure__panel > p:not(.eyebrow) { max-width: none; }
    [data-chapter]::after { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-parallax] { transform: none !important; }
  }
</style>
