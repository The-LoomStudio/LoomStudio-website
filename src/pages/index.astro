---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ProductPreview from '../components/ProductPreview.astro';
import SkyBackdrop from '../components/SkyBackdrop.astro';
import IntroLoader from '../components/IntroLoader.astro';
import { ArrowRight } from '@lucide/astro';

const features = [
  {
    index: '01',
    title: '独立的剧情正文',
    copy: '正文只保留确认的情节发展，模型的草稿与推演归于后台，不再侵扰阅读',
  },
  {
    index: '02',
    title: '幕后推演空间',
    copy: '为 Agent 提供专属的工作历史，推演与逻辑校验独立发生，服务于故事，却不干扰故事',
  },
  {
    index: '03',
    title: '清晰的构建路径',
    copy: '角色设定、世界观规则与上下文如何装配，一览无余，提示词不再是不可解释的黑盒',
  },
];
---

<BaseLayout title="Loom Studio" description="专为长篇角色扮演与互动叙事打造的桌面工具：分离剧情正文、推演过程与提示词构建，让每一次选择都能延展成清晰的世界线">
  <IntroLoader />
  <SiteHeader />
  <SkyBackdrop />

  <main>
    <section class="hero" id="top" data-sky-intro>
      <div class="hero__sky-fade" aria-hidden="true"></div>
      <nav class="hero__sections" aria-label="发布页章节">
        <span>SECTIONS</span>
        <a href="#story">01 叙事</a>
        <a href="#system">02 系统</a>
        <a href="#architecture">03 架构</a>
      </nav>
      <div class="container hero__content">
        <div class="hero__copy">
          <div class="hero__heading-row">
            <h1><span>编织世界</span><em>交织故事</em></h1>
            <span class="hero__chapter-tag" aria-hidden="true">00 / WORLDLINE</span>
          </div>
          <p class="hero__lead">
            专为长篇角色扮演与互动叙事打造的桌面工具<br />
            分离剧情正文、推演过程与提示词构建，让每一次选择都能延展成清晰的世界线
          </p>
          <div class="hero__actions">
            <a class="button button--primary" href="/docs">开始阅读文档 <ArrowRight size={16} stroke-width={1.8} /></a>
            <a class="button" href="#story">探索 Loom Studio</a>
          </div>
          <div class="hero__banner">
            <img src="/brand/banner.png" alt="Loom Studio" width="240" height="180" loading="eager" decoding="async" />
          </div>
        </div>
      </div>
      <a class="hero__scroll" href="#story"><span>向下滚动探索</span><i></i></a>
    </section>

    <section class="manifesto" id="story">
      <div class="container manifesto__grid">
        <div class="manifesto__sticky" data-chapter="01 / NARRATIVE">
          <p class="eyebrow">Beyond the transcript</p>
          <h2>长篇互动叙事<br />需要超越单列对话的结构</h2>
          <p>
            单列对话往往止于零碎问答，但一个世界应当能够持续延伸<br />
            Loom Studio 将剧情正文与推演过程清晰分开，正文纯净连贯，分支随时可溯，让故事真正具备长篇沉浸的厚度
          </p>
        </div>
        <div class="manifesto__features">
          {features.map((feature) => (
            <article>
              <span>{feature.index}</span>
              <h3>{feature.title}</h3>
              <p>{feature.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="product" id="system">
      <div class="container">
        <div class="section-heading" data-chapter="02 / SYSTEM">
          <div>
            <p class="eyebrow">Inside the studio</p>
            <h2>秩序井然的<br />创作空间</h2>
          </div>
          <p>
            桌面级高信息密度界面，服务于专注而持久的创作<br />
            角色设定、正文时间线与后台推演各安其位，在保持视野开阔的同时，提供稳定可靠的掌控力
          </p>
        </div>
        <div class="product__stage" data-parallax="0.04">
          <ProductPreview />
        </div>
        <div class="product__legend">
          <div><span>01</span><b>Narrative Timeline</b><p>只保存受控提交的故事正文与世界线</p></div>
          <div><span>02</span><b>Agent Session</b><p>容纳推演、工具调用与独立工作分支</p></div>
          <div><span>03</span><b>Prompt Build</b><p>以资源、激活与链路解释每轮上下文装配</p></div>
        </div>
      </div>
    </section>

    <section class="architecture" id="architecture">
      <div class="container architecture__inner" data-chapter="03 / ARCHITECTURE">
        <p class="eyebrow">Built for depth</p>
        <h2>分层明确<br />始于长远</h2>
        <div class="architecture__flow">
          <div><small>STORY</small><b>剧情正文</b><span>呈现故事与分支</span></div>
          <i>↔</i>
          <div><small>WORK</small><b>推演会话</b><span>负责逻辑推导与工具</span></div>
          <i>→</i>
          <div><small>CONTEXT</small><b>提示词构建</b><span>负责资源装配与激活</span></div>
          <i>→</i>
          <div><small>MODEL</small><b>模型接入</b><span>只接收编译结果</span></div>
        </div>
        <p class="architecture__note">
          正文专注于呈现，会话专注于推演，构建器专注于装配<br />
          各层各司其职，让系统能够从容支撑起庞大的世界观与漫长的故事跨度
        </p>
      </div>
    </section>

    <section class="adventure" data-sky-final>
      <div class="adventure__fade" aria-hidden="true"></div>
      <div class="container adventure__content">
        <div class="adventure__panel" data-chapter="04 / ADVENTURE">
          <p class="eyebrow">Start your journey</p>
          <h2>走出文本框的局限</h2>
          <p>
            将复杂的机制沉入底层，让角色、情境与选择重新回到舞台中央<br />
            由此开始，编织一段真正完整、能够长久延续的故事
          </p>
          <a class="button button--primary" href="/docs">进入公开文档 <ArrowRight size={16} stroke-width={1.8} /></a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter easterEgg />

  <script>
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const parallaxItems = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
    let frame = 0;

    const updateParallax = () => {
      frame = 0;
      if (reduceMotion.matches) return;
      const viewport = window.innerHeight;
      for (const item of parallaxItems) {
        const rect = item.getBoundingClientRect();
        if (rect.bottom < -200 || rect.top > viewport + 200) continue;
        const speed = Number(item.dataset.parallax ?? 0);
        const centerOffset = rect.top + rect.height / 2 - viewport / 2;
        item.style.setProperty('--parallax-y', String(centerOffset * speed) + 'px');
      }
    };

    const requestUpdate = () => {
      if (!frame) frame = window.requestAnimationFrame(updateParallax);
    };

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate);
    updateParallax();
  </script>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: max(800px, 100svh);
    display: grid;
    align-items: center;
    overflow: hidden;
    padding-top: calc(var(--loom-site-header-height) + 36px);
    padding-bottom: 72px;
    background: transparent;
  }
  .hero__sky-fade {
    position: absolute;
    z-index: 0;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(var(--loom-site-bg-channels) / 0) 0%,
      rgb(var(--loom-site-bg-channels) / 0.08) 20%,
      rgb(var(--loom-site-bg-channels) / 0.32) 42%,
      rgb(var(--loom-site-bg-channels) / 0.72) 68%,
      rgb(var(--loom-site-bg-channels) / 0.96) 86%,
      rgb(var(--loom-site-bg-channels) / 1) 100%
    );
    pointer-events: none;
  }
  .hero__sections {
    position: absolute;
    z-index: 2;
    top: calc(var(--loom-site-header-height) + 24px);
    left: 50%;
    width: min(calc(100% - 40px), var(--loom-site-max-width));
    display: flex;
    align-items: center;
    gap: 22px;
    color: var(--loom-site-text-subtle);
    font: 10px var(--loom-site-font-mono);
    letter-spacing: 0.14em;
    transform: translateX(-50%);
  }
  .hero__sections span { opacity: 0.62; letter-spacing: 0.2em; }
  .hero__sections a { transition: color 160ms ease; }
  .hero__sections a:hover { color: var(--loom-site-text); }
  .hero__content {
    display: flex;
    align-items: center;
    margin-top: 40px;
  }
  .hero__copy {
    position: relative;
    z-index: 1;
    max-width: 740px;
    background: transparent;
  }
  .hero__heading-row {
    display: inline-flex;
    align-items: flex-start;
    gap: 20px;
  }
  .hero__chapter-tag {
    color: var(--loom-site-text-subtle);
    font: 8px var(--loom-site-font-mono);
    letter-spacing: 0.2em;
    writing-mode: vertical-rl;
    opacity: 0.7;
    margin-top: 6px;
    user-select: none;
    pointer-events: none;
  }
  .hero h1 {
    margin: 0;
    font: 560 clamp(54px, 6vw, 76px)/1.06 var(--loom-site-font-display);
    letter-spacing: -0.04em;
    text-wrap: balance;
    text-shadow: none;
  }
  .hero h1 em {
    display: block;
    color: var(--loom-site-accent);
    font-style: normal;
  }
  .hero__lead {
    max-width: 610px;
    margin: 28px 0 0;
    color: var(--loom-site-text-muted);
    font-size: 17px;
    line-height: 1.85;
    text-wrap: pretty;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 36px;
  }
  .hero__banner {
    margin-top: 40px;
    margin-bottom: 12px;
    display: inline-block;
  }
  .hero__banner img {
    display: block;
    width: clamp(210px, 24vw, 260px);
    height: auto;
    filter: drop-shadow(0 14px 32px rgba(0, 0, 0, 0.1));
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1), filter 300ms ease;
  }
  .hero__banner img:hover {
    transform: translateY(-2px) scale(1.02);
    filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.18));
  }
  .hero__scroll {
    position: absolute;
    z-index: 1;
    bottom: 28px;
    left: 50%;
    display: grid;
    justify-items: center;
    gap: 10px;
    color: var(--loom-site-text-subtle);
    font: 8px var(--loom-site-font-mono);
    letter-spacing: 0.16em;
    transform: translateX(-50%);
  }
  .hero__scroll i { width: 1px; height: 38px; background: var(--loom-site-text-subtle); }
  .manifesto {
    position: relative;
    min-height: 1550px;
    overflow: clip;
    padding: 160px 0;
    background: var(--loom-site-bg);
  }
  .manifesto__grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 12vw; }
  .manifesto__sticky {
    position: sticky;
    top: 150px;
    height: fit-content;
    border-radius: 24px;
    padding: 32px;
    background: transparent;
  }
  .section-heading,
  .adventure__panel { position: relative; }
  [data-chapter]::after {
    content: attr(data-chapter);
    position: absolute;
    top: 24px;
    right: 20px;
    color: var(--loom-site-text-subtle);
    font: 8px var(--loom-site-font-mono);
    letter-spacing: 0.2em;
    writing-mode: vertical-rl;
  }
  .manifesto h2, .section-heading h2, .architecture h2, .adventure h2 {
    margin: 0;
    font: 540 clamp(42px, 5.6vw, 70px)/1.16 var(--loom-site-font-display);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .manifesto__sticky > p:last-child {
    max-width: 500px;
    margin: 28px 0 0;
    color: var(--loom-site-text-muted);
    font-size: 16px;
    line-height: 1.9;
  }
  .manifesto__features { display: grid; gap: 160px; padding-top: 180px; }
  .manifesto__features article {
    min-height: 300px;
    border-radius: 24px;
    padding: 32px;
    background: transparent;
  }
  .manifesto__features span { color: var(--loom-site-accent); font: 10px var(--loom-site-font-mono); letter-spacing: 0.14em; }
  .manifesto__features h3 { margin: 46px 0 18px; font: 560 30px/1.32 var(--loom-site-font-display); letter-spacing: 0.01em; }
  .manifesto__features p {
    max-width: 470px;
    margin: 0;
    color: var(--loom-site-text-muted);
    font-size: 15px;
    line-height: 1.85;
  }
  .product { position: relative; z-index: 2; padding: 150px 0 170px; background: var(--loom-site-bg); }
  .product > .container { position: relative; z-index: 1; }
  .section-heading {
    display: grid;
    grid-template-columns: 1.1fr 0.65fr;
    align-items: end;
    gap: 80px;
    margin-bottom: 78px;
    border-radius: 24px;
    padding: 32px;
    background: transparent;
  }
  .section-heading > p {
    margin: 0 0 8px;
    color: var(--loom-site-text-muted);
    font-size: 15px;
    line-height: 1.9;
  }
  .product__stage {
    transform: translate3d(0, var(--parallax-y, 0), 0);
    will-change: transform;
  }
  .product__legend {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 46px;
    background: transparent;
  }
  .product__legend > div {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px 14px;
    border-radius: 16px;
    padding: 30px;
    background: transparent;
  }
  .product__legend span { color: var(--loom-site-accent); font: 10px var(--loom-site-font-mono); }
  .product__legend b { font-size: 13px; }
  .product__legend p {
    grid-column: 2;
    margin: 0;
    color: var(--loom-site-text-subtle);
    font-size: 12px;
    line-height: 1.65;
  }
  .architecture {
    position: relative;
    min-height: 850px;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: var(--loom-site-bg);
  }
  .architecture::before {
    display: none;
  }
  .architecture__inner {
    position: relative;
    z-index: 1;
    border-radius: 30px;
    padding: 56px 40px;
    background: transparent;
    text-align: center;
  }
  .architecture h2 { max-width: 850px; margin-inline: auto; }
  .architecture__flow {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    align-items: center;
    gap: 14px;
    margin-top: 78px;
  }
  .architecture__flow > div {
    min-height: 145px;
    display: grid;
    align-content: center;
    gap: 8px;
    border-radius: 18px;
    padding: 18px;
    background: transparent;
  }
  .architecture__flow small { color: var(--loom-site-accent); font: 9px var(--loom-site-font-mono); letter-spacing: 0.14em; }
  .architecture__flow b { font: 600 16px var(--loom-site-font-display); }
  .architecture__flow span { color: var(--loom-site-text-subtle); font-size: 10px; }
  .architecture__flow > i { color: var(--loom-site-text-subtle); font-style: normal; }
  .architecture__note {
    max-width: 680px;
    margin: 44px auto 0;
    color: var(--loom-site-text-muted);
    font-size: 14px;
    line-height: 1.8;
  }
  .adventure {
    position: relative;
    min-height: 1000px;
    display: grid;
    align-items: end;
    overflow: hidden;
    color: var(--loom-site-text);
    background: transparent;
    transition: color 320ms ease;
  }
  .adventure[data-sky-text='dark'] {
    --loom-site-text: #26343d;
    --loom-site-text-muted: #3d4c55;
    --loom-site-text-subtle: #53636c;
    --loom-site-accent: #344f5c;
  }
  .adventure__fade {
    position: absolute;
    z-index: 1;
    top: -1px;
    left: 0;
    width: 100%;
    height: clamp(380px, 46vw, 720px);
    background: linear-gradient(
      180deg,
      rgb(var(--loom-site-bg-channels) / 1) 0%,
      rgb(var(--loom-site-bg-channels) / 0.96) 14%,
      rgb(var(--loom-site-bg-channels) / 0.78) 36%,
      rgb(var(--loom-site-bg-channels) / 0.5) 58%,
      rgb(var(--loom-site-bg-channels) / 0.22) 78%,
      rgb(var(--loom-site-bg-channels) / 0) 100%
    );
    pointer-events: none;
  }
  .adventure__content { position: relative; z-index: 2; padding-bottom: 120px; }
  .adventure__panel {
    max-width: 650px;
    border-radius: 30px;
    padding: 42px;
    background: transparent;
  }
  .adventure__panel h2 {
    font-size: clamp(52px, 6vw, 76px);
  }
  .adventure__panel > p:not(.eyebrow) {
    max-width: 560px;
    margin: 28px 0 34px;
    color: var(--loom-site-text-muted);
    font: 17px/1.9 var(--loom-site-font-display);
    text-shadow: none;
  }
  @media (max-width: 900px) {
    .manifesto { min-height: auto; }
    .manifesto__grid, .section-heading { grid-template-columns: 1fr; gap: 54px; }
    .manifesto__sticky { position: static; }
    .manifesto__features { gap: 100px; padding-top: 40px; }
    .product__legend { grid-template-columns: 1fr; }
    .architecture__flow { grid-template-columns: 1fr; }
    .architecture__flow > i { transform: rotate(90deg); }
  }
  @media (max-width: 680px) {
    .hero { min-height: 900px; }
    .hero__sections { width: calc(100% - 28px); gap: 12px; font-size: 8px; letter-spacing: 0.08em; }
    .hero__sections span { display: none; }
    .hero__copy { max-width: none; padding: 12px 0; }
    .hero__chapter-tag { display: none; }
    .manifesto, .product { padding-block: 110px; }
    .manifesto h2, .section-heading h2, .architecture h2 { font-size: 42px; }
    .manifesto__features article { min-height: auto; }
    .product__legend > div { padding: 24px 12px; }
    .architecture { padding: 110px 0; }
    .adventure { min-height: 820px; }
    .adventure__content { padding-bottom: 80px; }
    .adventure__panel { padding: 28px; }
    .adventure__panel h2,
    .adventure__panel > p:not(.eyebrow) { max-width: none; }
    [data-chapter]::after { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-parallax] { transform: none !important; }
  }
</style>
