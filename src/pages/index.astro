---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import NomSticker from '../components/NomSticker.astro';
import CharacterJourney from '../components/card-showcase/CharacterJourney.tsx';
import { cards } from '../components/card-showcase/CardMasonry.tsx';
import BrandWelcome, { brandCards } from '../components/brand-welcome/BrandWelcome';
import NomGuide, { nomExpressions, type NomExpression } from '../components/nom-guide/NomGuide';
import { getHomeGuide } from '../components/nom-guide/home-guide';
import HeroBanner, { slides } from '../components/HeroBanner';
import StoryParallaxWall from '../components/StoryParallaxWall.astro';
import StoryWorkspace from '../components/story-workspace/StoryWorkspace';
import PromptComposition from '../components/prompt-composition/PromptComposition';
import { siteImage } from '../lib/site-images';
import { ArrowUpRight } from '@lucide/astro';

const cardImages = Object.fromEntries(await Promise.all(cards.map(async ({ src }) => [src, await siteImage(src, [240, 480, 800])])));
const welcomeCards = brandCards.map(card => ({ ...card, image: cardImages[card.src] }));
const guideExpressions = Object.fromEntries(await Promise.all(nomExpressions.map(async expression => [
  expression, await siteImage(`/images/nom/stickers/bust/${expression}.png`, [80, 136, 272], 90),
]))) as Record<NomExpression, Awaited<ReturnType<typeof siteImage>>>;
const bannerImages = Object.fromEntries(await Promise.all(slides.map(async ({ src }) => [
  src, { ...await siteImage(src, [640, 960, 1440, 1920]), fullSrc: (await siteImage(src, [2560], 90)).src },
])));
const topImages = Object.fromEntries(slides.map(({ src }) => [src, bannerImages[src]]));
const layers = {
  background: await siteImage('/images/nom/layers/nom-layer-004.png', [768, 1280, 1920]),
  foreground: await siteImage('/images/nom/layers/nom-layer-002.png', [780, 1280, 1560], 90),
};
const brand = await siteImage('/brand/banner.png', [360, 720, 1080], 90);
const promptIllustration = await siteImage('/images/nom/illustrations/nom-illustration-001.png', [480, 960], 90);

import { getLocaleFromPath, getHomeCopy, getLocalizedPath, type SiteLocale } from '../lib/i18n';

interface Props {
  locale?: SiteLocale;
}

const { locale: propLocale } = Astro.props;
const currentLocale = propLocale ?? getLocaleFromPath(Astro.url.pathname);
const homeCopy = getHomeCopy(currentLocale);
const guide = getHomeGuide(currentLocale);

const descriptions: Record<SiteLocale, string> = {
  'zh-CN': 'Loom Studio 是本地运行的 AI 角色扮演与互动叙事工作台，将角色、世界设定、故事分支和 Agent 工具放在一起。',
  'en': 'Loom Studio is a local AI roleplay and interactive storytelling workbench bringing characters, lorebooks, branching narratives, and Agent tools together.',
  'ja': 'Loom Studio は、キャラクター、世界設定、ストーリー分岐、Agent ツールを統合したローカル実行型 AI インタラクティブノベル制作スタジオです。',
  'ko': 'Loom Studio는 캐릭터, 세계관 설정, 이야기 분기 및 Agent 도구를 한곳에 모은 로컬 실행형 AI 롤플레잉 및 인터랙티브 서사 작업대입니다.',
};
---

<BaseLayout title="Loom Studio" description={descriptions[currentLocale]} locale={currentLocale}>
  <SiteHeader locale={currentLocale} />

  <main>
    <section class="hero" id="top">
      <HeroBanner client:load images={topImages} layers={layers} />
    </section>

    <div class="home-content">
    <BrandWelcome client:visible={{ rootMargin: '200px' }} id="brand-intro" cards={welcomeCards} logo={brand}
      copy={guide.brand} downloadHref={getLocalizedPath('/download', currentLocale)} />
    <noscript><style is:inline>.brand-ascii { --brand-image-opacity: 1 !important; }.brand-ascii > canvas { display: none; }</style></noscript>

    <section id="characters" class="card-banner card-banner--top" aria-labelledby="card-banner-title">
      <div class="container card-banner__heading" data-motion-reveal>
        <div class="card-banner__copy">
          <p class="eyebrow">{homeCopy.cardBanner.eyebrow}</p>
          <h2 id="card-banner-title">{homeCopy.cardBanner.title}</h2>
        </div>
      </div>
      <CharacterJourney client:visible={{ rootMargin: '400px' }} images={cardImages} />
    </section>

    <PromptComposition client:visible portrait={promptIllustration.src} />
    <noscript><style is:inline>.prompt-composition__picture img, .prompt-composition figcaption { opacity: 1 !important; }</style></noscript>

    <StoryWorkspace client:visible expressions={guideExpressions} />

    <StoryParallaxWall />
    <section id="nom-stickers" class="home-nom" aria-labelledby="home-nom-title">
      <div class="container home-nom__inner">
        <div>
          <h2 id="home-nom-title" set:html={homeCopy.stickersBanner.title} />
          {homeCopy.stickersBanner.paragraphs.map((p) => <p>{p}</p>)}
          <a href={getLocalizedPath('/stickers', currentLocale)} data-motion-feedback>{homeCopy.stickersBanner.button} <ArrowUpRight size={18} aria-hidden="true" /></a>
        </div>
        <div class="home-nom__stickers" data-motion-drift aria-hidden="true">
          <NomSticker src="/images/nom/stickers/bust/giggle.png" size="large" />
          <NomSticker src="/images/nom/stickers/bust/tea.png" size="large" />
          <NomSticker src="/images/nom/stickers/bust/sleepy.png" size="large" />
        </div>
      </div>
    </section>
    </div>


  </main>

  <SiteFooter easterEgg locale={currentLocale} />
  <NomGuide client:idle sections={guide.sections} expressions={guideExpressions} reactions={guide.reactions} copy={guide.controls} />


  <script>
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const parallaxItems = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
    let frame = 0;

    const updateParallax = () => {
      frame = 0;
      if (reduceMotion.matches) return;
      const viewport = window.innerHeight;
      for (const item of parallaxItems) {
        const rect = item.getBoundingClientRect();
        if (rect.bottom < -200 || rect.top > viewport + 200) continue;
        const speed = Number(item.dataset.parallax ?? 0);
        const centerOffset = rect.top + rect.height / 2 - viewport / 2;
        item.style.setProperty('--parallax-y', String(centerOffset * speed) + 'px');
      }
    };

    const requestUpdate = () => {
      if (!frame) frame = window.requestAnimationFrame(updateParallax);
    };

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate);
    updateParallax();

    const finePointer = window.matchMedia('(pointer: fine)');
    let scrollTarget = window.scrollY;
    let scrollFrame = 0;
    let lastScrollTime = 0;

    const stopWheelScroll = () => {
      window.cancelAnimationFrame(scrollFrame);
      scrollFrame = 0;
      scrollTarget = window.scrollY;
    };

    const animateWheelScroll = (time: number) => {
      scrollTarget = Math.max(0, Math.min(scrollTarget, document.documentElement.scrollHeight - window.innerHeight));
      const current = window.scrollY;
      const distance = scrollTarget - current;
      if (Math.abs(distance) < 0.5) {
        window.scrollTo({ top: scrollTarget, behavior: 'instant' });
        scrollFrame = 0;
        return;
      }
      const amount = 1 - Math.exp(-(time - lastScrollTime) / 100);
      lastScrollTime = time;
      window.scrollTo({ top: current + distance * amount, behavior: 'instant' });
      scrollFrame = window.requestAnimationFrame(animateWheelScroll);
    };

    const onWheel = (event: WheelEvent) => {
      if (
        reduceMotion.matches || !finePointer.matches || event.defaultPrevented || !event.cancelable ||
        event.ctrlKey || event.metaKey || event.shiftKey || !event.deltaY ||
        Math.abs(event.deltaY) < Math.abs(event.deltaX) ||
        document.documentElement.hasAttribute('data-menu-open') || document.querySelector('dialog[open]')
      ) {
        stopWheelScroll();
        return;
      }
      // Let demo panes, editors and other nested scroll areas retain native input.
      for (const element of event.composedPath()) {
        if (element === document.body || element === document.documentElement) break;
        if (!(element instanceof HTMLElement)) continue;
        if (
          element.matches('input, textarea, select, [contenteditable]:not([contenteditable="false"])') ||
          (/(auto|scroll)/.test(getComputedStyle(element).overflowY) && element.scrollHeight > element.clientHeight)
        ) {
          stopWheelScroll();
          return;
        }
      }
      event.preventDefault();
      if (!scrollFrame) scrollTarget = window.scrollY;
      const unit = event.deltaMode === WheelEvent.DOM_DELTA_LINE ? 16 : event.deltaMode === WheelEvent.DOM_DELTA_PAGE ? window.innerHeight : 1;
      const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
      scrollTarget = Math.max(0, Math.min(maxScroll, scrollTarget + event.deltaY * unit * 0.45));
      if (!scrollFrame) {
        lastScrollTime = performance.now();
        scrollFrame = window.requestAnimationFrame(animateWheelScroll);
      }
    };

    window.addEventListener('wheel', onWheel, { passive: false });
    window.addEventListener('pointerdown', stopWheelScroll, { passive: true, capture: true });
    window.addEventListener('touchstart', stopWheelScroll, { passive: true, capture: true });
    window.addEventListener('keydown', stopWheelScroll, { capture: true });
    window.addEventListener('resize', stopWheelScroll);
    window.addEventListener('pagehide', stopWheelScroll);
    reduceMotion.addEventListener('change', stopWheelScroll);
    finePointer.addEventListener('change', stopWheelScroll);
  </script>
</BaseLayout>

<style>
  .home-nom { padding: 100px 0; background: var(--loom-site-bg); }
  .home-nom__inner { display: grid; grid-template-columns: 1fr 1.1fr; gap: 48px; align-items: center; }
  .home-nom h2 { margin: 20px 0; font: 550 clamp(28px, 4vw, 48px)/1.25 var(--loom-site-font-display); letter-spacing: -.03em; }
  .home-nom p:not(.eyebrow) { color: var(--loom-site-text-muted); font-size: 14px; line-height: 1.9; }
  .home-nom a { display: inline-flex; align-items: center; gap: 12px; margin-top: 18px; padding-bottom: 8px; border-bottom: 1px solid var(--loom-site-border-strong); font-size: 14px; }
  .home-nom__stickers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: center; }
  .home-nom__stickers > :nth-child(1) { transform: rotate(-8deg) translateY(20px); }
  .home-nom__stickers > :nth-child(2) { transform: translateY(-24px); }
  .home-nom__stickers > :nth-child(3) { transform: rotate(8deg) translateY(24px); }
  .home-nom__stickers :global(.nom-sticker__image) { width: 100%; }
  @media (max-width: 700px) {
    .home-nom { padding: 64px 0 80px; }
    .home-nom__inner { grid-template-columns: 1fr; gap: 48px; }
  }
</style>

<style>
  :global(body:has(.hero)) {
    --loom-site-font-sans: "Nunito", "ZCOOL KuaiLe", "PingFang SC", sans-serif;
    --loom-site-font-display: "Fredoka", "ZCOOL KuaiLe", sans-serif;
  }
  .hero {
    position: relative;
    z-index: 1;
    height: 100svh;
    min-height: 100svh;
    display: grid;
    align-items: center;
    overflow: clip;
    padding: 0;
    background: transparent;
  }
  .home-content {
    position: relative;
    z-index: 2;
    background: var(--loom-site-bg);
  }
  .hero::after {
    position: absolute;
    z-index: 2;
    bottom: 0;
    right: 0;
    left: 0;
    height: 240px;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgb(var(--loom-site-bg-channels) / .08) 22%,
      rgb(var(--loom-site-bg-channels) / .34) 52%,
      rgb(var(--loom-site-bg-channels) / .78) 78%,
      var(--loom-site-bg) 100%
    );
    content: '';
    pointer-events: none;
  }
  .hero__sky-fade {
    position: absolute;
    z-index: 0;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(var(--loom-site-bg-channels) / 0) 0%,
      rgb(var(--loom-site-bg-channels) / 0.08) 20%,
      rgb(var(--loom-site-bg-channels) / 0.32) 42%,
      rgb(var(--loom-site-bg-channels) / 0.72) 68%,
      rgb(var(--loom-site-bg-channels) / 0.96) 86%,
      rgb(var(--loom-site-bg-channels) / 1) 100%
    );
    pointer-events: none;
  }
  .hero__content {
    position: absolute;
    top: 50svh;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 0;
    text-align: center;
  }
  .hero__copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 740px;
    width: 100%;
    background: transparent;
  }
  .hero__heading-row {
    position: absolute;
    left: calc(50% + clamp(120px, 16vw, 180px) + 24px);
    top: 50%;
    transform: translateY(-50%);
    display: block;
    gap: 20px;
  }
  .hero__chapter-tag {
    color: var(--loom-site-text-subtle);
    font: 8px var(--loom-site-font-mono);
    letter-spacing: 0.2em;
    writing-mode: vertical-rl;
    opacity: 0.7;
    margin-top: 6px;
    user-select: none;
    pointer-events: none;
  }
  .hero h1 {
    margin: 0;
    font: 400 clamp(18px, 2vw, 26px)/1.6 var(--loom-site-font-display);
    letter-spacing: 0.18em;
    writing-mode: vertical-rl;
    white-space: nowrap;
    text-wrap: balance;
    text-shadow: none;
  }
  .hero h1 em {
    display: block;
    color: var(--loom-site-accent);
    font-style: normal;
  }
  .hero__lead {
    position: absolute;
    top: 100%;
    width: min(610px, 90vw);
    max-width: 610px;
    margin: 24px auto 0;
    color: var(--loom-site-text-muted);
    font-size: 17px;
    line-height: 1.85;
    text-wrap: pretty;
  }
  .hero__actions {
    position: absolute;
    top: calc(100% + 124px);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 0;
  }
  .hero__banner {
    margin-top: 0;
    margin-bottom: 0;
    display: block;
    max-width: 100%;
  }
  .hero__banner img {
    display: block;
    width: clamp(240px, 32vw, 360px);
    max-width: 100%;
    height: auto;
    filter: drop-shadow(0 14px 32px rgba(0, 0, 0, 0.1));
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1), filter 300ms ease;
  }
  .hero__banner img:hover {
    transform: scale(1.02);
    filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.18));
  }
  .card-banner {
    position: relative;
    overflow: clip;
    padding: 110px 0 92px;
    background: var(--loom-site-bg);
  }
  .card-banner__heading {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    margin-bottom: 48px;
    text-align: center;
  }
  .card-banner__copy { position: relative; }
  .card-banner__heading h2 {
    margin: 0;
    font: 540 clamp(38px, 5vw, 64px)/1.18 var(--loom-site-font-display);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .card-stack-banner {
    position: relative;
    min-height: 760px;
    overflow: hidden;
    background: var(--loom-site-bg-soft);
  }
  .card-stack-banner__stage {
    position: relative;
    min-height: 760px;
    display: grid;
    align-items: center;
  }
  .card-stack-banner__heading {
    position: relative;
    z-index: 1;
    display: grid;
    width: min(440px, calc(100% - 40px));
    justify-items: center;
    text-align: center;
  }
  .card-stack-banner__heading h2 {
    margin: 0;
    font: 540 clamp(42px, 5.6vw, 70px)/1.16 var(--loom-site-font-display);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .card-stack-banner__heading > p:last-child {
    max-width: 560px;
    margin: 24px 0 0;
    color: var(--loom-site-text-muted);
    font-size: 15px;
    line-height: 1.85;
  }
  .card-stack-banner__stage > .card-showcase {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .card-stack-banner__stage .card-showcase__card {
    pointer-events: auto;
  }
  @media (max-width: 680px) {
    .hero { height: clamp(440px, 100vw, 600px); min-height: 0; }
    .hero::after { height: 80px; }
    .hero__banner img { width: 54vw; max-width: 240px; }
    .hero__heading-row { left: calc(50% + min(27vw, 120px) + 10px); }
    .hero__copy { max-width: none; padding: 0; }
    .hero__chapter-tag { display: none; }
    .card-banner { padding-block: 80px; }
    .card-banner__heading { margin-bottom: 30px; }
    .card-stack-banner,
    .card-stack-banner__stage { min-height: 620px; }
    [data-chapter]::after { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-parallax] { transform: none !important; }
  }
</style>
