---
import '../styles/global.css';
import '../styles/site-motion.css';
import PageArrival from '../components/PageArrival.astro';
import { getImage } from 'astro:assets';
import socialBanner from '../../public/images/nom/banners/og-banner.png';
import { type SiteLocale, getLocaleFromPath, localeHtmlLang, stripLocalePrefix, t } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  image?: string;
  locale?: SiteLocale;
}

const {
  title,
  description,
  image,
  locale: propLocale,
} = Astro.props;
const currentLocale = propLocale ?? getLocaleFromPath(Astro.url.pathname);
const unlocalizedPath = stripLocalePrefix(Astro.url.pathname);
const defaultImage = image ? undefined : await getImage({ src: socialBanner, width: 1200, format: 'jpg', quality: 88 });
const imageUrl = new URL(image ?? defaultImage!.src, Astro.site ?? import.meta.env.CF_PAGES_URL ?? Astro.url).href;
const pageTitle = title === 'Loom Studio'
  ? `Loom Studio ${t(currentLocale, 'portal.homeSuffix')}`
  : `${title} ${t(currentLocale, 'portal.suffix')}`;
---

<!doctype html>
<html lang={localeHtmlLang[currentLocale]} data-theme={unlocalizedPath === '/' ? 'dark' : 'light'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <!-- Declare opt-in before first paint; dev stylesheets arrive through Vite modules. -->
    <style is:inline>
      @view-transition { navigation: auto; }
    </style>
    <meta name="theme-color" content={Astro.url.pathname === '/' ? '#252b31' : '#82919b'} data-theme-color />
    <script is:inline>
      try {
        const pendingTransition = sessionStorage.getItem('loom-site-route-transition');
        if (pendingTransition) {
          const transition = JSON.parse(pendingTransition);
          if (
            transition.pathname === window.location.pathname
            && Date.now() - transition.createdAt < 5000
            && ['curtain', 'fade'].includes(transition.direction)
          ) {
            document.documentElement.dataset.routeTransition = transition.direction;
          }
          sessionStorage.removeItem('loom-site-route-transition');
        }

        const isHomePage = /^\/(?:en|ja|ko)?\/?$/.test(window.location.pathname);
        if (!isHomePage) {
          const savedTheme = localStorage.getItem('loom-site-theme');
          if (savedTheme === 'light' || savedTheme === 'dark') {
            document.documentElement.dataset.theme = savedTheme;
            document.documentElement.style.colorScheme = savedTheme;
            document.querySelector('[data-theme-color]')?.setAttribute('content', savedTheme === 'dark' ? '#252b31' : '#82919b');
          }
        }

        // Auto-detect locale from browser on first visit
        const userSavedLocale = localStorage.getItem('loom-site-locale');
        const pathname = window.location.pathname;
        const currentLangPrefix = (pathname.match(/^\/(en|ja|ko)(?:\/|$)/) || [])[1];
        const isZhPath = !currentLangPrefix;

        if (!userSavedLocale && isZhPath) {
          const navLangs = navigator.languages || [navigator.language || ''];
          let detectedLocale = null;
          for (const lang of navLangs) {
            const l = lang.toLowerCase();
            if (l.startsWith('zh')) { detectedLocale = 'zh-CN'; break; }
            if (l.startsWith('ja')) { detectedLocale = 'ja'; break; }
            if (l.startsWith('ko')) { detectedLocale = 'ko'; break; }
            if (l.startsWith('en')) { detectedLocale = 'en'; break; }
          }
          if (!detectedLocale) detectedLocale = 'en'; // default fallback for other international users

          if (detectedLocale !== 'zh-CN') {
            const targetPath = '/' + detectedLocale + (pathname === '/' ? '' : pathname);
            window.location.replace(targetPath);
          }
        }
      } catch {}
    </script>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={imageUrl} />
    {defaultImage && <>
      <meta property="og:image:type" content="image/jpeg" />
      <meta property="og:image:width" content={defaultImage.attributes.width} />
      <meta property="og:image:height" content={defaultImage.attributes.height} />
      <meta property="og:image:alt" content="Loom Studio 官方分享横幅" />
    </>}
    <meta property="og:site_name" content="Loom Studio 官方门户" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/brand/website_logo.png" />
    <link rel="apple-touch-icon" href="/brand/website_logo.png" />
    <title>{pageTitle}</title>
    {(['/', '/docs/architecture', '/news', '/marketplace'].includes(Astro.url.pathname) || Astro.url.pathname.startsWith('/marketplace/') || unlocalizedPath === '/stickers') && <>
      <link rel="preconnect" href="https://fonts.googleapis.com" />
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600&family=Nunito:wght@400;500;600;700&family=ZCOOL+KuaiLe&display=swap" rel="stylesheet" />
    </>}
  </head>
  <body>
    <PageArrival locale={currentLocale} />
    {unlocalizedPath !== '/docs/architecture' && <div class="site-reading-progress" data-reading-progress aria-hidden="true"></div>}
    <slot />
    <div
      class="page-scrollbar"
      role="scrollbar"
      aria-label="页面滚动"
      aria-orientation="vertical"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
      tabindex="0"
      data-page-scrollbar
      hidden
    ></div>
    <script>
      import '../scripts/site-motion';
      const pageScrollbar = document.querySelector<HTMLElement>('[data-page-scrollbar]');
      if (pageScrollbar) {
        let frame = 0;
        let thumbHeight = 0;
        let maxTravel = 0;
        let maxScroll = 0;
        let dragStartY = 0;
        let dragStartScroll = 0;
        let dragging = false;

        const updateScrollbar = () => {
          frame = 0;
          const viewportHeight = window.innerHeight;
          const documentHeight = document.documentElement.scrollHeight;
          maxScroll = Math.max(0, documentHeight - viewportHeight);
          pageScrollbar.hidden = maxScroll < 1;
          if (pageScrollbar.hidden) return;

          const trackHeight = Math.max(0, viewportHeight - 8);
          thumbHeight = Math.max(48, trackHeight * viewportHeight / documentHeight);
          maxTravel = Math.max(0, trackHeight - thumbHeight);
          const progress = maxScroll ? window.scrollY / maxScroll : 0;
          pageScrollbar.style.height = `${thumbHeight}px`;
          pageScrollbar.style.transform = `translateY(${4 + maxTravel * progress}px)`;
          pageScrollbar.setAttribute('aria-valuenow', String(Math.round(progress * 100)));
        };

        const requestScrollbarUpdate = () => {
          if (!frame) frame = window.requestAnimationFrame(updateScrollbar);
        };

        const stopDragging = () => {
          if (!dragging) return;
          dragging = false;
          delete document.documentElement.dataset.scrollbarDragging;
        };

        pageScrollbar.addEventListener('pointerdown', (event) => {
          dragging = true;
          dragStartY = event.clientY;
          dragStartScroll = window.scrollY;
          document.documentElement.dataset.scrollbarDragging = '';
          pageScrollbar.setPointerCapture(event.pointerId);
          event.preventDefault();
        });

        pageScrollbar.addEventListener('pointermove', (event) => {
          if (!dragging || !maxTravel) return;
          const nextScroll = dragStartScroll + (event.clientY - dragStartY) * maxScroll / maxTravel;
          window.scrollTo(0, Math.min(maxScroll, Math.max(0, nextScroll)));
        });

        pageScrollbar.addEventListener('pointerup', stopDragging);
        pageScrollbar.addEventListener('pointercancel', stopDragging);
        pageScrollbar.addEventListener('keydown', (event) => {
          const movements: Record<string, number> = {
            ArrowUp: -48,
            ArrowDown: 48,
            PageUp: -window.innerHeight * 0.85,
            PageDown: window.innerHeight * 0.85,
            Home: -window.scrollY,
            End: maxScroll - window.scrollY,
          };
          const movement = movements[event.key];
          if (movement === undefined) return;
          window.scrollBy(0, movement);
          event.preventDefault();
        });

        const resizeObserver = new ResizeObserver(requestScrollbarUpdate);
        resizeObserver.observe(document.body);
        window.addEventListener('scroll', requestScrollbarUpdate, { passive: true });
        window.addEventListener('resize', requestScrollbarUpdate);
        window.addEventListener('pagehide', () => {
          window.cancelAnimationFrame(frame);
          resizeObserver.disconnect();
          window.removeEventListener('scroll', requestScrollbarUpdate);
          window.removeEventListener('resize', requestScrollbarUpdate);
        }, { once: true });
        updateScrollbar();
      }
    </script>
  </body>
</html>
